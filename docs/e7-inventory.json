{
 "cyrus-sasl": {
  "actions": []
 },
 "dnsmasq": {
  "actions": []
 },
 "firewalld": {
  "actions": []
 },
 "glusterfs": {
  "actions": []
 },
 "libvirt": {
  "actions": []
 },
 "linux-pam": {
  "actions": []
 },
 "networkmanager": {
  "actions": [
   {
    "section": "configure",
    "verb": "mkdir",
    "path": "/opt/hud/share/gir-1.0",
    "kind": "unit-in-prefix",
    "line": "mkdir -p /opt/hud/share/gir-1.0"
   },
   {
    "section": "configure",
    "verb": "cp",
    "path": "/opt/hud/share/gir-1.0/",
    "kind": "unit-in-prefix",
    "line": "cp -v \"/usr/share/gir-1.0/$gir\" /opt/hud/share/gir-1.0/"
   }
  ]
 },
 "nftables": {
  "actions": [
   {
    "section": "postinst",
    "verb": "redirect",
    "path": "/etc/ld.so.conf.d/hud.conf",
    "kind": "ship",
    "line": "echo \"/opt/hud/lib\" > /etc/ld.so.conf.d/hud.conf"
   },
   {
    "section": "postinst",
    "verb": "redirect",
    "path": "/etc/ld.so.conf.d/hud.conf",
    "kind": "ship",
    "line": "echo \"/opt/hud/lib64\" >> /etc/ld.so.conf.d/hud.conf"
   }
  ]
 },
 "qemu": {
  "actions": [
   {
    "section": "postinst",
    "verb": "chmod",
    "path": "/opt/hud/libexec/qemu-bridge-helper",
    "kind": "unit-in-prefix",
    "line": "chmod 4750 /opt/hud/libexec/qemu-bridge-helper 2>/dev/null || true"
   }
  ]
 },
 "wpa_supplicant": {
  "actions": [
   {
    "section": "postinst",
    "verb": "redirect",
    "path": "/etc/wpa_supplicant/wpa_supplicant-<iface>.conf\"",
    "kind": "config",
    "line": "echo \"  Configure wireless with: wpa_passphrase SSID > /etc/wpa_supplicant/wpa_supplicant-<iface>.conf\""
   }
  ]
 }
}