# HUD Package Definition - sentry-sdk 2.35.0
# Official Sentry SDK for Python
# Error tracking and monitoring

Package: python-sentry-sdk
Version: 2.35.0
Architecture: x86_64
Section: python
Depends: python, python-certifi, python-urllib3
Description: Official Python SDK for Sentry.io error tracking
Source: https://github.com/getsentry/sentry-python/releases/download/2.35.0/sentry_sdk-2.35.0.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR sentry-sdk

[postinst]
echo "✓ Python sentry-sdk 2.35.0 installed"
