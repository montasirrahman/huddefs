# HUD Package Definition - xcursor-themes 1.0.7
# Default cursor themes for X
Package: xcursor-themes
Version: 1.0.7
Architecture: x86_64
Section: xorg-data
Depends: libXcursor
Description: Default cursor themes for X
Source: https://www.x.org/pub/individual/data/xcursor-themes-1.0.7.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xcursor-themes 1.0.7 installed to /opt/hud"
