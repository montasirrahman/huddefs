# HUD Package Definition - xf86-video-vesa 2.6.0
# Xorg VESA video driver
Package: xf86-video-vesa
Version: 2.6.0
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server
Description: Xorg generic VESA video driver (fallback)
Source: https://www.x.org/pub/individual/driver/xf86-video-vesa-2.6.0.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-video-vesa 2.6.0 installed to /opt/hud"
