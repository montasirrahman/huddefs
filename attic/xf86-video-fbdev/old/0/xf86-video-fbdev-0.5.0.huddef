# HUD Package Definition - xf86-video-fbdev 0.5.0
# Xorg framebuffer video driver
Package: xf86-video-fbdev
Version: 0.5.0
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server
Description: Xorg framebuffer video driver
Source: https://www.x.org/pub/individual/driver/xf86-video-fbdev-0.5.0.tar.bz2
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-video-fbdev 0.5.0 installed to /opt/hud"
