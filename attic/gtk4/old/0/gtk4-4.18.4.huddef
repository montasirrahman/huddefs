# HUD Package Definition - gtk4 4.18.4
# GIMP Toolkit version 4
Package: gtk4
Version: 4.18.4
Architecture: x86_64
Section: graphics
Depends: glib,pango,gdk-pixbuf,cairo,graphene,libepoxy,wayland,wayland-protocols,libxkbcommon,mesa
Description: GIMP Toolkit version 4 for creating graphical user interfaces
Source: https://download.gnome.org/sources/gtk/4.18/gtk-4.18.4.tar.xz
[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release \
    -Dx11-backend=true \
    -Dwayland-backend=true \
    -Dbroadway-backend=true \
    -Dmedia-gstreamer=disabled \
    -Dbuild-demos=false \
    -Dbuild-tests=false \
    -Dbuild-examples=false \
    ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ gtk4 4.18.4 installed to /opt/hud"
/sbin/ldconfig
glib-compile-schemas /opt/hud/share/glib-2.0/schemas 2>/dev/null || true
