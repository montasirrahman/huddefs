# HUD Package Definition - build 1.3.0
# Python build frontend implementing PEP-517
# Required for building many modern Python packages

Package: python-build
Version: 1.3.0
Architecture: x86_64
Section: python
Depends: python, python-pyproject-hooks
Description: Python build frontend implementing PEP-517
Source: https://files.pythonhosted.org/packages/source/b/build/build-1.3.0.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR build

[postinst]
echo "✓ Python build 1.3.0 installed"
echo "  Program: pyproject-build"
