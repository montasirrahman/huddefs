# HUD Package Definition - xf86-input-evdev 2.10.6
# Xorg evdev input driver
Package: xf86-input-evdev
Version: 2.10.6
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server,libevdev,mtdev
Description: Xorg evdev input driver for Linux event devices
Source: https://www.x.org/pub/individual/driver/xf86-input-evdev-2.10.6.tar.bz2
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-input-evdev 2.10.6 installed to /opt/hud"
