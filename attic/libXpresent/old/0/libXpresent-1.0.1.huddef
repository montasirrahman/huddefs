# HUD Package Definition - libXpresent 1.0.1
# X Present Extension Library
Package: libXpresent
Version: 1.0.1
Architecture: x86_64
Section: xorg
Depends: libX11,libXext,libXfixes,libXrandr
Description: Library interface to the X Present Extension
Source: https://www.x.org/pub/individual/lib/libXpresent-1.0.1.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXpresent 1.0.1 installed to /opt/hud"
/sbin/ldconfig
