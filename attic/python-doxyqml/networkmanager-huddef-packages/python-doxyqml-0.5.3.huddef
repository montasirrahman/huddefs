# HUD Package Definition - doxyqml 0.5.3
# Doxygen filter for QML
# Generate Doxygen documentation from QML

Package: python-doxyqml
Version: 0.5.3
Architecture: x86_64
Section: python
Depends: python, doxygen
Description: Doxygen input filter for QML files
Source: https://files.pythonhosted.org/packages/source/d/doxyqml/doxyqml-0.5.3.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR doxyqml

[check]
python3 tests/functional/tests.py
python3 tests/unit/tests.py

[postinst]
echo "✓ Python doxyqml 0.5.3 installed"
echo "  Program: doxyqml"
