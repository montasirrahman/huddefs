# HUD Package Definition - xcb-util-xrm 1.3
# XCB X resource manager library
Package: xcb-util-xrm
Version: 1.3
Architecture: x86_64
Section: xorg
Depends: libxcb,xcb-util
Description: XCB utility functions for X resource manager
Source: https://github.com/Airblader/xcb-util-xrm/releases/download/v1.3/xcb-util-xrm-1.3.tar.bz2
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xcb-util-xrm 1.3 installed to /opt/hud"
/sbin/ldconfig
