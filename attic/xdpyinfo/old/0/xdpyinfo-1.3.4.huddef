# HUD Package Definition - xdpyinfo 1.3.4
# Display information utility for X
Package: xdpyinfo
Version: 1.3.4
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXext,libXtst,libXxf86vm,libXxf86dga,libXrender,libXcomposite,libXinerama
Description: Display information utility for X
Source: https://www.x.org/pub/individual/app/xdpyinfo-1.3.4.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xdpyinfo 1.3.4 installed to /opt/hud"
