# HUD Package Definition - lxml 6.0.0
# Python bindings for libxml2 and libxslt
# High-performance XML processing library

Package: python-lxml
Version: 6.0.0
Architecture: x86_64
Section: python
Depends: python, libxml2, libxslt
Description: Python bindings for libxml2 and libxslt
Source: https://files.pythonhosted.org/packages/source/l/lxml/lxml-6.0.0.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include -I/opt/hud/include/libxml2"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR lxml

[postinst]
echo "✓ Python lxml 6.0.0 installed"
