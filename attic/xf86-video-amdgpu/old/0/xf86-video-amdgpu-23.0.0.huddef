# HUD Package Definition - xf86-video-amdgpu 23.0.0
# Xorg AMD GPU video driver
Package: xf86-video-amdgpu
Version: 23.0.0
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server,libdrm,mesa
Description: Xorg video driver for AMD Radeon GPUs
Source: https://www.x.org/pub/individual/driver/xf86-video-amdgpu-23.0.0.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-video-amdgpu 23.0.0 installed to /opt/hud"
