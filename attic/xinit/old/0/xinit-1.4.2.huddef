# HUD Package Definition - xinit 1.4.2
# X Window System initializer
Package: xinit
Version: 1.4.2
Architecture: x86_64
Section: xorg-apps
Depends: libX11,xauth,xrdb
Description: X Window System initializer
Source: https://www.x.org/pub/individual/app/xinit-1.4.2.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static --with-xinitdir=/etc/X11/xinit
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xinit 1.4.2 installed to /opt/hud"
