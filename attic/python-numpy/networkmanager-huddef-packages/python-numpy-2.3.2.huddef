# HUD Package Definition - NumPy 2.3.2
# Fundamental package for scientific computing with Python
# Core numerical array library

Package: python-numpy
Version: 2.3.2
Architecture: x86_64
Section: python
Depends: python, python-cython, python-meson-python, gcc, gfortran
Description: Fundamental package for scientific computing with Python
Source: https://files.pythonhosted.org/packages/source/n/numpy/numpy-2.3.2.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir \
    -C setup-args=-Dallow-noblas=true $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR numpy

[postinst]
echo "✓ Python NumPy 2.3.2 installed"
echo "  Programs: f2py, f2py3"
