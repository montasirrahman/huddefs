# HUD Package Definition - ovirt-hosted-engine-setup 2.6.0
# Auto-generated for oVirt infrastructure

Package: ovirt-hosted-engine-setup
Version: 2.6.0
Architecture: x86_64
Section: virtualization
Depends: python3,ovirt-hosted-engine-ha,ansible,ovirt-engine-sdk-python
Description: oVirt Hosted Engine Setup Tools
Source: https://github.com/oVirt/ovirt-hosted-engine-setup/archive/refs/tags/v2.6.0.tar.gz

[configure]
./configure --prefix=/opt/hud

[build]
