# HUD Package Definition - xf86-input-libinput 1.5.0
# Xorg libinput input driver
Package: xf86-input-libinput
Version: 1.5.0
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server,libinput
Description: Xorg input driver based on libinput
Source: https://www.x.org/pub/individual/driver/xf86-input-libinput-1.5.0.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-input-libinput 1.5.0 installed to /opt/hud"
