# HUD Package Definition - ovirt-web-ui 1.9.0
# Auto-generated for oVirt infrastructure

Package: ovirt-web-ui
Version: 1.9.0
Architecture: x86_64
Section: virtualization
Depends: nodejs,ovirt-engine
Description: oVirt Web User Interface
Source: https://github.com/oVirt/ovirt-web-ui/archive/refs/tags/1.9.0.tar.gz

[configure]
./configure --prefix=/opt/hud

[build]
npm install && npm run build

[install]
mkdir -p $DESTDIR/opt/hud/share/ovirt-web-ui && cp -r build/* $DESTDIR/opt/hud/share/ovirt-web-ui/

[postinst]
ldconfig 2>/dev/null || true
echo "ovirt-web-ui 1.9.0 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
