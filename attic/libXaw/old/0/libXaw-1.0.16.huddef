# HUD Package Definition - libXaw 1.0.16
# X Athena Widgets Library
Package: libXaw
Version: 1.0.16
Architecture: x86_64
Section: xorg
Depends: libXmu,libXpm
Description: X Athena Widgets Library
Source: https://www.x.org/pub/individual/lib/libXaw-1.0.16.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXaw 1.0.16 installed to /opt/hud"
/sbin/ldconfig
