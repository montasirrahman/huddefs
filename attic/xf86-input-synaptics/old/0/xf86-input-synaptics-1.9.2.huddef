# HUD Package Definition - xf86-input-synaptics 1.9.2
# Xorg Synaptics touchpad driver
Package: xf86-input-synaptics
Version: 1.9.2
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server,libevdev,libXi,libXtst
Description: Xorg Synaptics touchpad input driver
Source: https://www.x.org/pub/individual/driver/xf86-input-synaptics-1.9.2.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-input-synaptics 1.9.2 installed to /opt/hud"
