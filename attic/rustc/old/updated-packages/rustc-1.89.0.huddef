# HUD Package Definition - Rust 1.89.0
# The Rust Programming Language

Package: rustc
Version: 1.89.0
Architecture: x86_64
Section: development
Depends: curl, cmake, ninja, python3, llvm
Description: The Rust Programming Language compiler and cargo
Source: https://static.rust-lang.org/dist/rustc-1.89.0-src.tar.xz

[configure]
cat > config.toml << 'CONF'
[llvm]
link-shared = true
targets = "X86"
[build]
target = ["x86_64-unknown-linux-gnu"]
docs = false
extended = true
tools = ["cargo", "clippy", "rustfmt"]
[install]
prefix = "/opt/hud"
[rust]
channel = "stable"
rpath = false
CONF

[build]
python3 x.py build --stage 2

[install]
DESTDIR=$DESTDIR python3 x.py install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ Rust 1.89.0 installed to /opt/hud"
