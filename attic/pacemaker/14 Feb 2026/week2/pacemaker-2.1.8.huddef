# HUD Package Definition - pacemaker 2.1.8
# High availability cluster resource manager
# Section: clustering

Package: pacemaker
Version: 2.1.8
Architecture: x86_64
Section: clustering
Depends: corosync, libqb, glib, libxml2, libuuid
Description: High availability cluster resource manager
Source: https://github.com/ClusterLabs/pacemaker/releases/download/Pacemaker-2.1.8/pacemaker-2.1.8.tar.bz2

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

--prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --libdir=/opt/hud/lib64 --with-corosync

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install



[postinst]
echo "/opt/hud/lib" > /etc/ld.so.conf.d/pacemaker.conf
echo "/opt/hud/lib64" >> /etc/ld.so.conf.d/pacemaker.conf
ldconfig


groupadd -r haclient 2>/dev/null || true
useradd -r -g haclient -d /var/lib/pacemaker -s /sbin/nologin hacluster 2>/dev/null || true

mkdir -p /var/lib/pacemaker
chown hacluster:haclient /var/lib/pacemaker

cat > /etc/systemd/system/pacemaker.service << 'EOFSVC'
[Unit]
Description=Pacemaker High Availability Cluster Manager
After=corosync.service
Requires=corosync.service

[Service]
Type=notify
ExecStart=/opt/hud/sbin/pacemakerd -f
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOFSVC

systemctl daemon-reload
echo "Pacemaker installed. Enable after corosync is configured."


echo ""
echo "============================================"
echo "pacemaker 2.1.8 installed"
echo "============================================"
echo ""
