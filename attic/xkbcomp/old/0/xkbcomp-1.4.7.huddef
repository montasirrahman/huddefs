# HUD Package Definition - xkbcomp 1.4.7
# XKB keyboard description compiler
Package: xkbcomp
Version: 1.4.7
Architecture: x86_64
Section: xorg
Depends: libX11,libxkbfile
Description: XKB keyboard description compiler
Source: https://www.x.org/pub/individual/app/xkbcomp-1.4.7.tar.xz
[configure]
./configure --prefix=/opt/hud
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xkbcomp 1.4.7 installed to /opt/hud"
