# HUD Package Definition - doxypypy 0.8.8.7
# Doxygen filter for Python
# Generate Doxygen documentation from Python

Package: python-doxypypy
Version: 0.8.8.7
Architecture: x86_64
Section: python
Depends: python, python-chardet, doxygen
Description: Doxygen filter for Python code
Source: https://files.pythonhosted.org/packages/source/d/doxypypy/doxypypy-0.8.8.7.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR doxypypy

[postinst]
echo "✓ Python doxypypy 0.8.8.7 installed"
echo "  Program: doxypypy"
