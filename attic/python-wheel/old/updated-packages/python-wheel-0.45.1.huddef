# HUD Package Definition - wheel 0.45.1
# Python wheel packaging

Package: python-wheel
Version: 0.45.1
Architecture: x86_64
Section: python-modules
Depends: python3, python-setuptools
Description: A built-package format for Python
Source: https://files.pythonhosted.org/packages/source/w/wheel/wheel-0.45.1.tar.gz

[configure]
# No configure needed

[build]
/opt/hud/bin/python3 -m build --wheel --no-isolation

[install]
/opt/hud/bin/pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR dist/*.whl

[postinst]
echo "✓ wheel 0.45.1 installed to /opt/hud"
