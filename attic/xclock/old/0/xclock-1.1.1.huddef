# HUD Package Definition - xclock 1.1.1
# Analog/digital clock for X
Package: xclock
Version: 1.1.1
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXaw,libXmu,libXrender,libXft,libxkbfile
Description: Analog/digital clock for X
Source: https://www.x.org/pub/individual/app/xclock-1.1.1.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xclock 1.1.1 installed to /opt/hud"
