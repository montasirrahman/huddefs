# HUD Package Definition - xcb-util 0.4.1
# XCB utility library
Package: xcb-util
Version: 0.4.1
Architecture: x86_64
Section: xorg
Depends: libxcb
Description: Utility libraries for XCB
Source: https://xorg.freedesktop.org/archive/individual/lib/xcb-util-0.4.1.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xcb-util 0.4.1 installed to /opt/hud"
/sbin/ldconfig
