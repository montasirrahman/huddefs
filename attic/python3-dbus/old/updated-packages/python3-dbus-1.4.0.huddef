# HUD Package Definition - dbus-python 1.4.0
# Based on BLFS 12.4
Package: python3-dbus
Version: 1.4.0
Architecture: x86_64
Section: python
Depends: python3,dbus,glib,python3-meson-python,patchelf
Description: D-Bus Python-1.4.0 - Python bindings to the D-Bus API
Source: https://dbus.freedesktop.org/releases/dbus-python/dbus-python-1.4.0.tar.xz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user dbus-python
[postinst]
echo "python3-dbus 1.4.0 installed"
[prerm]
pip3 uninstall -y dbus-python 2>/dev/null || true
[postrm]
# Cleanup if needed
