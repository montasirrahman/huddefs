# HUD Package Definition - libXcomposite 0.4.6
# X Composite Extension Library
Package: libXcomposite
Version: 0.4.6
Architecture: x86_64
Section: xorg
Depends: libXfixes
Description: X Composite Extension Library
Source: https://www.x.org/pub/individual/lib/libXcomposite-0.4.6.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXcomposite 0.4.6 installed to /opt/hud"
/sbin/ldconfig
