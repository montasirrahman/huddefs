# HUD Package Definition - LLVM 20.1.8
# The LLVM Compiler Infrastructure

Package: llvm
Version: 20.1.8
Architecture: x86_64
Section: development
Depends: cmake, ninja, python3, zlib, libffi, libxml2
Description: LLVM Compiler Infrastructure with Clang
Source: https://github.com/llvm/llvm-project/releases/download/llvmorg-20.1.8/llvm-project-20.1.8.src.tar.xz

[configure]
mkdir -p build && cd build && \
cmake -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/opt/hud \
    -DCMAKE_BUILD_TYPE=Release \
    -DLLVM_ENABLE_PROJECTS="clang;clang-tools-extra;lld" \
    -DLLVM_BUILD_LLVM_DYLIB=ON \
    -DLLVM_LINK_LLVM_DYLIB=ON \
    -DCLANG_LINK_CLANG_DYLIB=ON \
    -DLLVM_ENABLE_FFI=ON \
    -DLLVM_ENABLE_RTTI=ON \
    -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
    -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_INCLUDE_TESTS=OFF \
    ../llvm

[build]
cd build && ninja -j$(nproc)

[install]
cd build && DESTDIR=$DESTDIR ninja install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ LLVM 20.1.8 installed to /opt/hud"
