# HUD Package Definition - pytest 8.4.1
# Python testing framework
# Standard testing framework for Python projects

Package: python-pytest
Version: 8.4.1
Architecture: x86_64
Section: python
Depends: python, python-iniconfig, python-pluggy, python-setuptools-scm
Description: Python testing framework
Source: https://files.pythonhosted.org/packages/source/p/pytest/pytest-8.4.1.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR pytest

[postinst]
echo "✓ Python pytest 8.4.1 installed"
echo "  Programs: pytest, py.test"
