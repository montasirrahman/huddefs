# HUD Package Definition - libXfont2 2.0.7
# X font library
Package: libXfont2
Version: 2.0.7
Architecture: x86_64
Section: xorg
Depends: libfontenc,freetype,xorgproto
Description: X font library
Source: https://www.x.org/pub/individual/lib/libXfont2-2.0.7.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static --disable-devel-docs
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXfont2 2.0.7 installed to /opt/hud"
/sbin/ldconfig
