# HUD Package Definition - dbusmock 0.36.0
# Based on BLFS 12.4
Package: python3-dbusmock
Version: 0.36.0
Architecture: x86_64
Section: python
Depends: python3,python3-dbus
Description: dbusmock-0.36.0 - Python library for writing tests for D-Bus services
Source: https://files.pythonhosted.org/packages/source/p/python-dbusmock/python_dbusmock-0.36.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user python-dbusmock
[postinst]
echo "python3-dbusmock 0.36.0 installed"
[prerm]
pip3 uninstall -y python-dbusmock 2>/dev/null || true
[postrm]
# Cleanup if needed
