# HUD Package Definition - libFS 1.0.10
# X Font Server library
Package: libFS
Version: 1.0.10
Architecture: x86_64
Section: xorg
Depends: xorgproto,xtrans
Description: X Font Server library interface
Source: https://www.x.org/pub/individual/lib/libFS-1.0.10.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libFS 1.0.10 installed to /opt/hud"
/sbin/ldconfig
