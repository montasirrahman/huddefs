# HUD Package Definition - mom 0.6.4
# Memory Overcommitment Manager
# Section: virtualization

Package: mom
Version: 0.6.4
Architecture: x86_64
Section: virtualization
Depends: python3, libvirt
Description: Memory Overcommitment Manager
Source: https://resources.ovirt.org/pub/ovirt-4.5/src/mom/mom-0.6.4.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

--prefix=/opt/hud

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install



[postinst]
echo "/opt/hud/lib" > /etc/ld.so.conf.d/mom.conf
echo "/opt/hud/lib64" >> /etc/ld.so.conf.d/mom.conf
ldconfig


cat > /etc/systemd/system/momd.service << 'EOFSVC'
[Unit]
Description=Memory Overcommitment Manager
After=libvirtd.service
Requires=libvirtd.service

[Service]
Type=simple
ExecStart=/opt/hud/sbin/momd -d
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOFSVC

systemctl daemon-reload


echo ""
echo "============================================"
echo "mom 0.6.4 installed"
echo "============================================"
echo ""
