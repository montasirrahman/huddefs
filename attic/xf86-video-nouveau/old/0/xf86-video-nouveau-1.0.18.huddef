# HUD Package Definition - xf86-video-nouveau 1.0.18
# Xorg Nouveau video driver
Package: xf86-video-nouveau
Version: 1.0.18
Architecture: x86_64
Section: xorg-drivers
Depends: xorg-server,libdrm,mesa
Description: Xorg video driver for NVIDIA GPUs (open source)
Source: https://www.x.org/pub/individual/driver/xf86-video-nouveau-1.0.18.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xf86-video-nouveau 1.0.18 installed to /opt/hud"
