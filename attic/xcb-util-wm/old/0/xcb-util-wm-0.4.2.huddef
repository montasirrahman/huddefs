# HUD Package Definition - xcb-util-wm 0.4.2
# XCB window manager library
Package: xcb-util-wm
Version: 0.4.2
Architecture: x86_64
Section: xorg
Depends: libxcb
Description: XCB EWMH and ICCCM helper libraries
Source: https://xorg.freedesktop.org/archive/individual/lib/xcb-util-wm-0.4.2.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xcb-util-wm 0.4.2 installed to /opt/hud"
/sbin/ldconfig
