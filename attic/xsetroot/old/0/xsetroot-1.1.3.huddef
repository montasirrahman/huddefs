# HUD Package Definition - xsetroot 1.1.3
# Root window parameter setting utility for X
Package: xsetroot
Version: 1.1.3
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXmu,libXcursor,xbitmaps
Description: Root window parameter setting utility for X
Source: https://www.x.org/pub/individual/app/xsetroot-1.1.3.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xsetroot 1.1.3 installed to /opt/hud"
