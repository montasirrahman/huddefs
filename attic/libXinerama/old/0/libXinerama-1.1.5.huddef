# HUD Package Definition - libXinerama 1.1.5
# Xinerama Library
Package: libXinerama
Version: 1.1.5
Architecture: x86_64
Section: xorg
Depends: libXext
Description: Xinerama Library for multi-monitor support
Source: https://www.x.org/pub/individual/lib/libXinerama-1.1.5.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXinerama 1.1.5 installed to /opt/hud"
/sbin/ldconfig
