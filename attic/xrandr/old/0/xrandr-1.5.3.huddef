# HUD Package Definition - xrandr 1.5.3
# Primitive command line interface to RandR extension
Package: xrandr
Version: 1.5.3
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXrandr,libXrender
Description: Primitive command line interface to RandR extension
Source: https://www.x.org/pub/individual/app/xrandr-1.5.3.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xrandr 1.5.3 installed to /opt/hud"
