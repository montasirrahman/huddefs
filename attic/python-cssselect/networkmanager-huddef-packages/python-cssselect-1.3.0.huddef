# HUD Package Definition - cssselect 1.3.0
# CSS selectors for Python
# Parse and translate CSS3 selectors to XPath

Package: python-cssselect
Version: 1.3.0
Architecture: x86_64
Section: python
Depends: python, python-setuptools-scm
Description: CSS selectors for Python
Source: https://files.pythonhosted.org/packages/source/c/cssselect/cssselect-1.3.0.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR cssselect

[postinst]
echo "✓ Python cssselect 1.3.0 installed"
