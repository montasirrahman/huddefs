# HUD Package Definition - xkill 1.0.6
# Kill a client by its X resource
Package: xkill
Version: 1.0.6
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXmu
Description: Kill a client by its X resource
Source: https://www.x.org/pub/individual/app/xkill-1.0.6.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xkill 1.0.6 installed to /opt/hud"
