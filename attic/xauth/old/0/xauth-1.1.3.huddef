# HUD Package Definition - xauth 1.1.3
# X authority file utility
Package: xauth
Version: 1.1.3
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXau,libXext,libXmu
Description: X authority file utility
Source: https://www.x.org/pub/individual/app/xauth-1.1.3.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xauth 1.1.3 installed to /opt/hud"
