# HUD Package Definition - docutils 0.21.2
# Documentation utilities for Python
# Processes plaintext documentation into HTML, XML, LaTeX

Package: python-docutils
Version: 0.21.2
Architecture: x86_64
Section: python
Depends: python
Description: Python documentation utilities
Source: https://files.pythonhosted.org/packages/source/d/docutils/docutils-0.21.2.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

# Remove old incompatible files if present
for f in /usr/bin/rst*.py; do
    rm -fv /usr/bin/$(basename $f .py) 2>/dev/null || true
done

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR docutils

[postinst]
echo "✓ Python docutils 0.21.2 installed"
echo "  Programs: docutils, rst2html, rst2html4, rst2html5, rst2latex,"
echo "            rst2man, rst2odt, rst2pseudoxml, rst2s5, rst2xetex,"
echo "            rst2xml, rstpep2html"
