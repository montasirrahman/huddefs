# HUD Package Definition - libXres 1.2.2
# X-Resource extension client library
Package: libXres
Version: 1.2.2
Architecture: x86_64
Section: xorg
Depends: libXext
Description: X-Resource extension client library
Source: https://www.x.org/pub/individual/lib/libXres-1.2.2.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXres 1.2.2 installed to /opt/hud"
/sbin/ldconfig
