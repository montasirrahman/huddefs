# HUD Package Definition - pyyaml 6.0.2
# Auto-generated for oVirt infrastructure

Package: pyyaml
Version: 6.0.2
Architecture: x86_64
Section: python
Depends: python3,libyaml
Description: YAML parser for Python
Source: https://files.pythonhosted.org/packages/source/P/PyYAML/pyyaml-6.0.2.tar.gz

[configure]
./configure --prefix=/opt/hud

[build]
python3 setup.py build

[install]
python3 setup.py install --prefix=/opt/hud --root=$DESTDIR

[postinst]
ldconfig 2>/dev/null || true
echo "pyyaml 6.0.2 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
