# HUD Package Definition - pygdbmi 0.11.0.0
# GDB/MI interface library
# Parse and interface with GDB Machine Interface

Package: python-pygdbmi
Version: 0.11.0.0
Architecture: x86_64
Section: python
Depends: python
Description: Parse GDB Machine Interface output with Python
Source: https://files.pythonhosted.org/packages/source/p/pygdbmi/pygdbmi-0.11.0.0.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-index --find-links dist --no-user --root=$DESTDIR pygdbmi

[postinst]
echo "✓ Python pygdbmi 0.11.0.0 installed"
