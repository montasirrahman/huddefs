# HUD Package Definition - xrdb 1.2.2
# X server resource database utility
Package: xrdb
Version: 1.2.2
Architecture: x86_64
Section: xorg-apps
Depends: libX11,libXmu
Description: X server resource database utility
Source: https://www.x.org/pub/individual/app/xrdb-1.2.2.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xrdb 1.2.2 installed to /opt/hud"
