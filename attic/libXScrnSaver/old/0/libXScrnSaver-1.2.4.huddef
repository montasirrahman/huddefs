# HUD Package Definition - libXScrnSaver 1.2.4
# X11 Screen Saver extension client library
Package: libXScrnSaver
Version: 1.2.4
Architecture: x86_64
Section: xorg
Depends: libXext
Description: X11 Screen Saver extension client library
Source: https://www.x.org/pub/individual/lib/libXScrnSaver-1.2.4.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libXScrnSaver 1.2.4 installed to /opt/hud"
/sbin/ldconfig
