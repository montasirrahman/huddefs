# HUD Package Definition - xcb-util-cursor 0.1.5
# XCB cursor library
Package: xcb-util-cursor
Version: 0.1.5
Architecture: x86_64
Section: xorg
Depends: libxcb,xcb-util-image,xcb-util-renderutil
Description: XCB cursor library
Source: https://xorg.freedesktop.org/archive/individual/lib/xcb-util-cursor-0.1.5.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xcb-util-cursor 0.1.5 installed to /opt/hud"
/sbin/ldconfig
