# HUD Package Definition - git 2.50.1
# Auto-generated for oVirt infrastructure

Package: git
Version: 2.50.1
Architecture: x86_64
Section: development
Description: Git-2.50.1
Source: https://www.kernel.org/pub/software/scm/git/git-2.50.1.tar.xz
Source-SHA256:    7e3e6c36decbd8f1eedd14d42db6674be03671c2204864befa2a41756c5c8fc4

Build-Depends:    curl, xmlto, valgrind, pcre2
Depends:          auto
Provides:         auto

[configure]
# GCC 15 defaults to C23, where an implicit function declaration is an error
# rather than a warning. git 2.50.1 predates that and fails on
#   builtin/archive.c: implicit declaration of function 'write_archive'
# -std=gnu17 is the conventional fix across distributions for exactly this, and
# changes nothing about what the package ships.
export CFLAGS="${CFLAGS:-} -std=gnu17"
./configure --prefix=/opt/hud

[build]
make prefix=/opt/hud all

[install]
make prefix=/opt/hud DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "git 2.50.1 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
