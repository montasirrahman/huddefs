# HUD Package Definition - xbitmaps 1.1.3
# Bitmap images used by X applications
Package: xbitmaps
Version: 1.1.3
Architecture: x86_64
Section: xorg-data
Depends: util-macros
Description: Bitmap images used by multiple X applications
Source: https://www.x.org/pub/individual/data/xbitmaps-1.1.3.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xbitmaps 1.1.3 installed to /opt/hud"
