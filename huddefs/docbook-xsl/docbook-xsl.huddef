# HUD Package Definition - docbook-xsl-nons 1.79.2
# DocBook XSL Stylesheets for XML transformations

Package: docbook-xsl
Version: 1.79.2
Architecture: noarch
Section: xml
Depends: libxml2,docbook
Description: DocBook XSL Stylesheets 1.79.2 - XSL stylesheets for DocBook XML transformations
Source: https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-nons-1.79.2.tar.bz2
Patches:          docbook-xsl-nons-1.79.2-stack_fix-1.patch

[configure]
# The stack_fix patch is applied by the builder from patches/ before this
# section runs. v1 declared it as a URL in a `Patch:` header and then guarded the
# apply on `[ -f ../<patch> ]` — a file nothing downloaded, so the test was never
# true and the patch was never applied. A guard like that is the same defect as
# `|| true`: it turns a missing patch into a silent no-op.

[build]
# No build needed - these are stylesheets

[install]
# Every path below was an absolute /opt/hud path with no $DESTDIR. The
# stylesheets were therefore copied into the build container's own filesystem
# and the package shipped nothing but its metadata — the same defect as the 66
# empty python3-* packages, reached by a different route.
install -v -m755 -d $DESTDIR/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2

cp -v -R VERSION assembly common eclipse epub epub3 extensions fo \
         highlighting html htmlhelp images javahelp lib manpages params \
         profiling roundtrip slides template tests tools webhelp website \
         xhtml xhtml-1_1 xhtml5 \
    $DESTDIR/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2

ln -sfn VERSION $DESTDIR/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2/VERSION.xsl

install -v -m755 -d $DESTDIR/opt/hud/share/doc/docbook-xsl-nons-1.79.2
install -v -m644 README $DESTDIR/opt/hud/share/doc/docbook-xsl-nons-1.79.2/README.txt
install -v -m644 RELEASE-NOTES* NEWS* $DESTDIR/opt/hud/share/doc/docbook-xsl-nons-1.79.2/ 2>/dev/null || true

# The catalog directory ships; the catalog itself does not. /opt/hud/etc/xml/
# catalog is a shared registry that several packages add entries to, so it is
# built and amended at install time like the ld.so cache, not owned by any one
# package.
install -v -m755 -d $DESTDIR/opt/hud/etc/xml

[postinst]

if [ ! -f /opt/hud/etc/xml/catalog ]; then
    xmlcatalog --noout --create /opt/hud/etc/xml/catalog
fi

# CDN entries (http)
xmlcatalog --noout --add "rewriteSystem" \
    "http://cdn.docbook.org/release/xsl-nons/1.79.2" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

xmlcatalog --noout --add "rewriteURI" \
    "http://cdn.docbook.org/release/xsl-nons/1.79.2" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

# CDN entries (https)
xmlcatalog --noout --add "rewriteSystem" \
    "https://cdn.docbook.org/release/xsl-nons/1.79.2" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

xmlcatalog --noout --add "rewriteURI" \
    "https://cdn.docbook.org/release/xsl-nons/1.79.2" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

# Current version entries (http)
xmlcatalog --noout --add "rewriteSystem" \
    "http://cdn.docbook.org/release/xsl-nons/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

xmlcatalog --noout --add "rewriteURI" \
    "http://cdn.docbook.org/release/xsl-nons/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

# Current version entries (https)
xmlcatalog --noout --add "rewriteSystem" \
    "https://cdn.docbook.org/release/xsl-nons/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

xmlcatalog --noout --add "rewriteURI" \
    "https://cdn.docbook.org/release/xsl-nons/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

# SourceForge legacy entries
xmlcatalog --noout --add "rewriteSystem" \
    "http://docbook.sourceforge.net/release/xsl/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

xmlcatalog --noout --add "rewriteURI" \
    "http://docbook.sourceforge.net/release/xsl/current" \
    "/opt/hud/share/xml/docbook/xsl-stylesheets-nons-1.79.2" \
    /opt/hud/etc/xml/catalog

echo "docbook-xsl-nons 1.79.2 installed to /opt/hud"

[prerm]
# Nothing to do

[postrm]
# Note: Catalog cleanup would require careful handling
echo "docbook-xsl-nons 1.79.2 removed - manual catalog cleanup may be required"
