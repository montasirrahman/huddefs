# HUD Package Definition - psutil 7.0.0
# Based on BLFS 12.4
Package: python3-psutil
Version: 7.0.0
Architecture: x86_64
Section: python
Description: psutil-7.0.0 - cross-platform library for process and system monitoring
Source: https://files.pythonhosted.org/packages/source/p/psutil/psutil-7.0.0.tar.gz
Source-SHA256:    7be9c3eba38beccb6495ea33afd982a44074b78f28c434a1f51cc07fd315c456

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist psutil --break-system-packages

[postinst]
echo "python3-psutil 7.0.0 installed"
