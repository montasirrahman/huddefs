# HUD Package Definition - libibverbs 53.0
# Auto-generated for oVirt infrastructure

Package: libibverbs
Version: 53.0
Architecture: x86_64
Section: libraries
Depends: cmake,libnl,python3
Description: RDMA verbs library
Source: https://github.com/linux-rdma/rdma-core/releases/download/v53.0/rdma-core-53.0.tar.gz

[configure]
