# HUD Package Definition - util-linux 2.41.1
# Linux Utility Programs
# Miscellaneous system utilities for Linux

Package: util-linux
Version: 2.41.1
Architecture: x86_64
Section: system
Description: Miscellaneous system utility programs including mount, fdisk, hwclock, etc.
Source: https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.1.tar.xz
Source-SHA256:    be9ad9a276f4305ab7dd2f5225c8be1ff54352f565ff4dede9628c1aaa7dec57

# ncurses, because configure looks for ncursesw/ncurses.h and the base system
# ships only the narrow headers. Without it the wide-character probe fails,
# cfdisk.c compiles against narrow curses, and get_wch is an implicit
# declaration — which GCC 15 makes an error. v1 declared no dependencies at all,
# so the conversion had nothing to carry over. Verified against both build
# roots: it fails identically with and without the rootfs debris, so this is a
# missing dependency and not the shrink.
Build-Depends:    ncurses, readline
Depends:          auto
Provides:         auto

[configure]
# The directory itself is staged in [install]; creating it here only wrote it
# into the build container, where configure did not need it either.

./configure --prefix=/opt/hud          \
            --libdir=/opt/hud/lib      \
            --runstatedir=/run         \
            --disable-chfn-chsh        \
            --disable-login            \
            --disable-nologin          \
            --disable-su               \
            --disable-setpriv          \
            --disable-runuser          \
            --disable-pylibmount       \
            --disable-static           \
            --disable-liblastlog2      \
            --without-python           \
            --without-systemd          \
            ADJTIME_PATH=/var/lib/hwclock/adjtime \
            --docdir=/opt/hud/share/doc/util-linux-2.41.1

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

# hwclock's state directory. It was created by [postinst], which left it
# untracked and outside FILES, so `hud remove` never cleaned it up.
install -v -dm755 $DESTDIR/var/lib/hwclock

[postinst]
ldconfig 2>/dev/null || true
echo "✓ util-linux 2.41.1 installed to /opt/hud"
