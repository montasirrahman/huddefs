# HUD Package Definition - util-linux 2.41.1
# Linux Utility Programs
# Miscellaneous system utilities for Linux

Package: util-linux
Version: 2.41.1
Architecture: x86_64
Section: system
Depends:
Description: Miscellaneous system utility programs including mount, fdisk, hwclock, etc.
Source: https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.1.tar.xz

[configure]
# The directory itself is staged in [install]; creating it here only wrote it
# into the build container, where configure did not need it either.

./configure --prefix=/opt/hud          \
            --libdir=/opt/hud/lib      \
            --runstatedir=/run         \
            --disable-chfn-chsh        \
            --disable-login            \
            --disable-nologin          \
            --disable-su               \
            --disable-setpriv          \
            --disable-runuser          \
            --disable-pylibmount       \
            --disable-static           \
            --disable-liblastlog2      \
            --without-python           \
            --without-systemd          \
            ADJTIME_PATH=/var/lib/hwclock/adjtime \
            --docdir=/opt/hud/share/doc/util-linux-2.41.1

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

# hwclock's state directory. It was created by [postinst], which left it
# untracked and outside FILES, so `hud remove` never cleaned it up.
install -v -dm755 $DESTDIR/var/lib/hwclock

[postinst]
ldconfig 2>/dev/null || true
echo "✓ util-linux 2.41.1 installed to /opt/hud"
