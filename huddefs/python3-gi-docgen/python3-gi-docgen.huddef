# HUD Package Definition - gi-docgen 2025.4
# Based on BLFS 12.4
Package: python3-gi-docgen
Version: 2025.4
Architecture: x86_64
Section: python
Description: Gi-DocGen-2025.4 - document generator for GObject-based libraries
Source: https://files.pythonhosted.org/packages/source/g/gi-docgen/gi_docgen-2025.4.tar.gz
Source-SHA256:    7fe066da082a4edcf924063767404f9d04a998f6c0f0c475b180fd9823a72dc5

Build-Depends:    python3, python3-markdown, python3-pygments, python3-typogrify, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist gi-docgen --break-system-packages

[postinst]
echo "python3-gi-docgen 2025.4 installed"
