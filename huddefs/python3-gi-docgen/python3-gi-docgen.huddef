# HUD Package Definition - gi-docgen 2025.4
# Based on BLFS 12.4
Package: python3-gi-docgen
Version: 2025.4
Architecture: x86_64
Section: python
Depends: python3,python3-markdown,python3-pygments,python3-typogrify
Description: Gi-DocGen-2025.4 - document generator for GObject-based libraries
Source: https://files.pythonhosted.org/packages/source/g/gi-docgen/gi_docgen-2025.4.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user gi-docgen
[postinst]
echo "python3-gi-docgen 2025.4 installed"
[prerm]
pip3 uninstall -y gi-docgen 2>/dev/null || true
[postrm]
# Cleanup if needed
