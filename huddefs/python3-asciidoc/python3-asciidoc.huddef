# HUD Package Definition - asciidoc 10.2.1
# Based on BLFS 12.4
Package: python3-asciidoc
Version: 10.2.1
Architecture: x86_64
Section: python
Depends: python3
Description: AsciiDoc-10.2.1 - text document format for writing documentation
Source: https://files.pythonhosted.org/packages/source/a/asciidoc/asciidoc-10.2.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user asciidoc
[postinst]
echo "python3-asciidoc 10.2.1 installed"
[prerm]
pip3 uninstall -y asciidoc 2>/dev/null || true
[postrm]
# Cleanup if needed
