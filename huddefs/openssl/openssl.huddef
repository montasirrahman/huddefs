# HUD Package Definition - openssl 3.5.2
# Cryptography and SSL/TLS toolkit
Package: openssl
Version: 3.5.2
Architecture: x86_64
Section: security
Description: Cryptography and SSL/TLS toolkit
Source: https://github.com/openssl/openssl/releases/download/openssl-3.5.2/openssl-3.5.2.tar.gz
Source-SHA256:    c53a47e5e441c930c3928cf7bf6fb00e5d129b630e0aa873b08258656e7345ec

Build-Depends:    zlib, perl
Depends:          auto
Provides:         auto

[configure]
./config --prefix=/opt/hud \
         --openssldir=/opt/hud/etc/ssl \
         --libdir=lib \
         shared \
         zlib-dynamic
[build]
make
[install]
sed -i '/INSTALL_LIBS/s/libcrypto.a libssl.a//' Makefile
make MANSUFFIX=ssl DESTDIR=$DESTDIR install
mv -v $DESTDIR/opt/hud/share/doc/openssl $DESTDIR/opt/hud/share/doc/openssl-3.5.2 2>/dev/null || true

# The CA directory structure and the bundle link. v1 built these in [postinst],
# so they were inside the prefix but still outside FILES: `hud remove openssl`
# left /opt/hud/etc/ssl behind.
#
# The link target is fixed at /etc/pki/tls/certs/ca-bundle.crt rather than
# chosen at install time. v1 fell back to /etc/ssl/certs/ca-certificates.crt,
# which means the same package behaves differently on two machines and neither
# choice is recorded anywhere. BlackFlag uses the make-ca layout — the same path
# python3-requests' patch compiles in — so that is the one that ships. A
# dangling symlink on a machine without make-ca is visible and fixable; a
# silently different trust root is not.
install -v -dm755 $DESTDIR/opt/hud/etc/ssl/certs
install -v -dm700 $DESTDIR/opt/hud/etc/ssl/private
ln -sfn /etc/pki/tls/certs/ca-bundle.crt $DESTDIR/opt/hud/etc/ssl/cert.pem

[postinst]
ldconfig 2>/dev/null || true
echo "✓ openssl 3.5.2 installed to /opt/hud"
/opt/hud/bin/openssl version 2>/dev/null || true