# HUD Package Definition - alsa-lib 1.2.14
# Auto-generated for oVirt infrastructure

Package: alsa-lib
Version: 1.2.14
Architecture: x86_64
Section: libraries
Description: alsa-lib-1.2.14
Source: https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.14.tar.bz2
Source-SHA256:    be9c88a0b3604367dd74167a2b754a35e142f670292ae47a2fdef27a2ee97a32

Build-Depends:    
# Explicit rather than auto: the UCM configuration is data read at runtime, so
# it appears in no ELF header, .pc file or dist-info and auto-detection cannot
# see it. Split out of this package's [install] — see docs/huddef-v2-spec.md.
Depends:          alsa-ucm-conf
Provides:         auto

[configure]
./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make install

# v1 continued with:
#   tar -C /usr/share/alsa --strip-components=1 -xf ../alsa-ucm-conf-1.2.14.tar.bz2
# an undeclared second upstream tarball, unpacked outside $DESTDIR. It is now
# its own package; see Depends: above and docs/huddef-v2-spec.md.

[postinst]
ldconfig 2>/dev/null || true
echo "alsa-lib 1.2.14 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
