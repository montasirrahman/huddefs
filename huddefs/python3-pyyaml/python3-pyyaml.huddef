# HUD Package Definition - PyYAML 6.0.2
# Based on BLFS 12.4
Package: python3-pyyaml
Version: 6.0.2
Architecture: x86_64
Section: python
Description: PyYAML-6.0.2 - YAML parser and emitter for Python
Source: https://files.pythonhosted.org/packages/source/P/PyYAML/pyyaml-6.0.2.tar.gz
Source-SHA256:    d584d9ec91ad65861cc08d42e834324ef890a082e591037abe114850ff7bbc3e

Build-Depends:    python3, python3-cython, libyaml, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist PyYAML --break-system-packages

[postinst]
echo "python3-pyyaml 6.0.2 installed"
