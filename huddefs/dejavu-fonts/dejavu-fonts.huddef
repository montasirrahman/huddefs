# HUD Package Definition - dejavu-fonts 2.37
# DejaVu fonts
Package: dejavu-fonts
Version: 2.37
Architecture: x86_64
Section: fonts
Description: DejaVu fonts based on Bitstream Vera fonts
Source: https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2
Source-SHA256:    fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
echo "No configure needed for fonts"
[build]
echo "No build needed for fonts"
[install]
mkdir -p $DESTDIR/opt/hud/share/fonts/dejavu
cp -v ttf/*.ttf $DESTDIR/opt/hud/share/fonts/dejavu/
[postinst]
echo "✓ dejavu-fonts 2.37 installed to /opt/hud"
fc-cache -f /opt/hud/share/fonts/dejavu 2>/dev/null || true
