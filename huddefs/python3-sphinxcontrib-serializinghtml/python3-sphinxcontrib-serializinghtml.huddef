# HUD Package Definition - sphinxcontrib-serializinghtml 2.0.0
# Based on BLFS 12.4
Package: python3-sphinxcontrib-serializinghtml
Version: 2.0.0
Architecture: x86_64
Section: python
Description: sphinxcontrib-serializinghtml-2.0.0 - Sphinx extension for serialized HTML
Source: https://files.pythonhosted.org/packages/source/s/sphinxcontrib_serializinghtml/sphinxcontrib_serializinghtml-2.0.0.tar.gz
Source-SHA256:    e9d912827f872c029017a53f0ef2180b327c3f7fd23c87229f7a8e8b70031d4d

Build-Depends:    python3, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist sphinxcontrib-serializinghtml --break-system-packages

[postinst]
echo "python3-sphinxcontrib-serializinghtml 2.0.0 installed"
