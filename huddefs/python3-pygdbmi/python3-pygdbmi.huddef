# HUD Package Definition - pygdbmi 0.11.0.0
# Based on BLFS 12.4
Package: python3-pygdbmi
Version: 0.11.0.0
Architecture: x86_64
Section: python
Depends: python3
Description: pygdbmi-0.11.0.0 - Python library for GDB/MI interface
Source: https://files.pythonhosted.org/packages/source/p/pygdbmi/pygdbmi-0.11.0.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user pygdbmi
[postinst]
echo "python3-pygdbmi 0.11.0.0 installed"
[prerm]
pip3 uninstall -y pygdbmi 2>/dev/null || true
[postrm]
# Cleanup if needed
