# HUD Package Definition - pygdbmi 0.11.0.0
# Based on BLFS 12.4
Package: python3-pygdbmi
Version: 0.11.0.0
Architecture: x86_64
Section: python
Description: pygdbmi-0.11.0.0 - Python library for GDB/MI interface
Source: https://files.pythonhosted.org/packages/source/p/pygdbmi/pygdbmi-0.11.0.0.tar.gz
Source-SHA256:    7a286be2fcf25650d9f66e11adc46e972cf078a466864a700cd44739ad261fb0

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pygdbmi --break-system-packages

[postinst]
echo "python3-pygdbmi 0.11.0.0 installed"
