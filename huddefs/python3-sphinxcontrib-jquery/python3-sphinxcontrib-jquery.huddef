# HUD Package Definition - sphinxcontrib-jquery 4.1
# Based on BLFS 12.4
Package: python3-sphinxcontrib-jquery
Version: 4.1
Architecture: x86_64
Section: python
Description: sphinxcontrib-jquery-4.1 - Sphinx extension to include jQuery
Source: https://files.pythonhosted.org/packages/source/s/sphinxcontrib-jquery/sphinxcontrib-jquery-4.1.tar.gz
Source-SHA256:    1620739f04e36a2c779f1a131a2dfd49b2fd07351bf1968ced074365933abc7a

Build-Depends:    python3, python3-sphinx, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist sphinxcontrib-jquery --break-system-packages

[postinst]
echo "python3-sphinxcontrib-jquery 4.1 installed"
