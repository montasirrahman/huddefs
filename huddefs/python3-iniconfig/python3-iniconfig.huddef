# HUD Package Definition - iniconfig 2.1.0
# Based on BLFS 12.4
Package: python3-iniconfig
Version: 2.1.0
Architecture: x86_64
Section: python
Depends: python3,python3-hatch-vcs
Description: Iniconfig-2.1.0 - small and simple INI-file parser module
Source: https://files.pythonhosted.org/packages/source/i/iniconfig/iniconfig-2.1.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user iniconfig
[postinst]
echo "python3-iniconfig 2.1.0 installed"
[prerm]
pip3 uninstall -y iniconfig 2>/dev/null || true
[postrm]
# Cleanup if needed
