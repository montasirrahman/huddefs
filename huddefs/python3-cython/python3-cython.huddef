# HUD Package Definition - cython 3.1.3
# Based on BLFS 12.4
Package: python3-cython
Version: 3.1.3
Architecture: x86_64
Section: python
Description: Cython-3.1.3 - compiler for writing C extensions for Python
Source: https://github.com/cython/cython/releases/download/3.1.3/cython-3.1.3.tar.gz
Source-SHA256:    10ee785e42328924b78f75a74f66a813cb956b4a9bc91c44816d089d5934c089

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist Cython --break-system-packages

[postinst]
echo "python3-cython 3.1.3 installed"
