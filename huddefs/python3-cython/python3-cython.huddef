# HUD Package Definition - cython 3.1.3
# Based on BLFS 12.4
Package: python3-cython
Version: 3.1.3
Architecture: x86_64
Section: python
Depends: python3
Description: Cython-3.1.3 - compiler for writing C extensions for Python
Source: https://github.com/cython/cython/releases/download/3.1.3/cython-3.1.3.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user Cython
[postinst]
echo "python3-cython 3.1.3 installed"
[prerm]
pip3 uninstall -y Cython 2>/dev/null || true
[postrm]
# Cleanup if needed
