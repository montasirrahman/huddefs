# HUD Package Definition - recommonmark 0.7.1
# Based on BLFS 12.4
Package: python3-recommonmark
Version: 0.7.1
Architecture: x86_64
Section: python
Description: Recommonmark-0.7.1 - docutils-compatibility bridge to CommonMark (deprecated)
Source: https://files.pythonhosted.org/packages/source/r/recommonmark/recommonmark-0.7.1.tar.gz
Source-SHA256:    bdb4db649f2222dcd8d2d844f0006b958d627f732415d399791ee436a3686d67

Build-Depends:    python3, python3-commonmark, python3-sphinx, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist recommonmark --break-system-packages

[postinst]
echo "python3-recommonmark 0.7.1 installed"
