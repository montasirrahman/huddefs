# HUD Package Definition - recommonmark 0.7.1
# Based on BLFS 12.4
Package: python3-recommonmark
Version: 0.7.1
Architecture: x86_64
Section: python
Depends: python3,python3-commonmark,python3-sphinx
Description: Recommonmark-0.7.1 - docutils-compatibility bridge to CommonMark (deprecated)
Source: https://files.pythonhosted.org/packages/source/r/recommonmark/recommonmark-0.7.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user recommonmark
[postinst]
echo "python3-recommonmark 0.7.1 installed"
[prerm]
pip3 uninstall -y recommonmark 2>/dev/null || true
[postrm]
# Cleanup if needed
