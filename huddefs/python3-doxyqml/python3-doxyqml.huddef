# HUD Package Definition - doxyqml 0.5.3
# Based on BLFS 12.4
Package: python3-doxyqml
Version: 0.5.3
Architecture: x86_64
Section: python
Description: Doxyqml-0.5.3 - allows using Doxygen to document QML classes
Source: https://files.pythonhosted.org/packages/source/d/doxyqml/doxyqml-0.5.3.tar.gz
Source-SHA256:    debfb621a3151c225f6fb4e9a8c6b86b2516e237e6f0fe60dcffee5b62d1796a

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist doxyqml --break-system-packages

[postinst]
echo "python3-doxyqml 0.5.3 installed"
