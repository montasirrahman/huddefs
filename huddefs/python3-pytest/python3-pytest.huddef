# HUD Package Definition - pytest 8.4.1
# Based on BLFS 12.4
Package: python3-pytest
Version: 8.4.1
Architecture: x86_64
Section: python
Depends: python3,python3-iniconfig,python3-pluggy
Description: Pytest-8.4.1 - framework for writing small, readable tests
Source: https://files.pythonhosted.org/packages/source/p/pytest/pytest-8.4.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user pytest
[postinst]
echo "python3-pytest 8.4.1 installed"
[prerm]
pip3 uninstall -y pytest 2>/dev/null || true
[postrm]
# Cleanup if needed
