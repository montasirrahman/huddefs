# HUD Package Definition - pytest 8.4.1
# Based on BLFS 12.4
Package: python3-pytest
Version: 8.4.1
Architecture: x86_64
Section: python
Description: Pytest-8.4.1 - framework for writing small, readable tests
Source: https://files.pythonhosted.org/packages/source/p/pytest/pytest-8.4.1.tar.gz
Source-SHA256:    7c67fd69174877359ed9371ec3af8a3d2b04741818c51e5e99cc1742251fa93c

Build-Depends:    python3, python3-iniconfig, python3-pluggy, python-setuptools, python3-setuptools-scm
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pytest --break-system-packages

[postinst]
echo "python3-pytest 8.4.1 installed"
