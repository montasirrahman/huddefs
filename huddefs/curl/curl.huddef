# HUD Package Definition - curl 8.15.0
# Auto-generated for oVirt infrastructure

Package: curl
Version: 8.15.0
Architecture: x86_64
Section: network
Description: cURL-8.15.0
Source: https://curl.se/download/curl-8.15.0.tar.xz
Source-SHA256:    6cd0a8a5b126ddfda61c94dc2c3fc53481ba7a35461cf7c5ab66aa9d6775b609


Build-Depends:    nghttp2, valgrind, gnutls, make-ca, brotli, libssh2, libpsl
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud --with-openssl --enable-threaded-resolver --with-libssh2

[build]
make -j$(nproc)

[install]
make install &&

rm -rf docs/examples/.deps &&

find docs \( -name Makefile\* -o  \
             -name \*.1       -o  \
             -name \*.3       -o  \
             -name CMakeLists.txt \) -delete

[postinst]
ldconfig 2>/dev/null || true
echo "curl 8.15.0 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
