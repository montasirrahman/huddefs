# HUD Package Definition - Scour 0.38.2
# Based on BLFS 12.4
Package: python3-scour
Version: 0.38.2
Architecture: x86_64
Section: python
Description: Scour-0.38.2 - SVG optimizer/cleaner
Source: https://github.com/scour-project/scour/archive/v0.38.2/scour-0.38.2.tar.gz
Source-SHA256:    26166de53d9da3eccc52570bf8c2853e60efefd9e90e26fdfc7124fe0bd873af

Build-Depends:    python3, python3-six, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist scour --break-system-packages

[postinst]
echo "python3-scour 0.38.2 installed"
