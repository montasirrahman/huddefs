# HUD Package Definition - numactl 2.0.19
# NUMA (Non-Uniform Memory Access) policy control library and tools
# Required by libvirt for NUMA-aware VM placement

Package: numactl
Version: 2.0.19
Architecture: x86_64
Section: system
Description: NUMA policy control library and utilities
Source: https://github.com/numactl/numactl/releases/download/v2.0.19/numactl-2.0.19.tar.gz
Source-SHA256:    f2672a0381cb59196e9c246bf8bcc43d5568bc457700a697f1a1df762b9af884

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"
./configure --prefix=/opt/hud

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
make

[install]
DESTDIR=$DESTDIR make install

[postinst]
ldconfig
echo "numactl 2.0.19 installed"
echo "Commands: numactl, numademo, numastat"
