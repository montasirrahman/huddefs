# HUD Package Definition - hatch-fancy-pypi-readme 25.1.0
# Based on BLFS 12.4
Package: python3-hatch-fancy-pypi-readme
Version: 25.1.0
Architecture: x86_64
Section: python
Depends: python3,python3-hatchling
Description: hatch-fancy-pypi-readme-25.1.0 - hatch plugin for readme metadata
Source: https://files.pythonhosted.org/packages/source/h/hatch-fancy-pypi-readme/hatch_fancy_pypi_readme-25.1.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user hatch-fancy-pypi-readme
[postinst]
echo "python3-hatch-fancy-pypi-readme 25.1.0 installed"
[prerm]
pip3 uninstall -y hatch-fancy-pypi-readme 2>/dev/null || true
[postrm]
# Cleanup if needed
