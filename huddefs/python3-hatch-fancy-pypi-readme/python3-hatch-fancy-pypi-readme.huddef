# HUD Package Definition - hatch-fancy-pypi-readme 25.1.0
# Based on BLFS 12.4
Package: python3-hatch-fancy-pypi-readme
Version: 25.1.0
Architecture: x86_64
Section: python
Description: hatch-fancy-pypi-readme-25.1.0 - hatch plugin for readme metadata
Source: https://files.pythonhosted.org/packages/source/h/hatch-fancy-pypi-readme/hatch_fancy_pypi_readme-25.1.0.tar.gz
Source-SHA256:    9c58ed3dff90d51f43414ce37009ad1d5b0f08ffc9fc216998a06380f01c0045

Build-Depends:    python3, python3-hatchling
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist hatch-fancy-pypi-readme --break-system-packages

[postinst]
echo "python3-hatch-fancy-pypi-readme 25.1.0 installed"
