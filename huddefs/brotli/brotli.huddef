# HUD Package Definition - brotli 1.1.0
# Brotli compression library

Package: brotli
Version: 1.1.0
Architecture: x86_64
Section: libraries
Depends: cmake
Description: Brotli compression format library
Source: https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz

[configure]
mkdir -p build && cd build && cmake .. \
    -DCMAKE_INSTALL_PREFIX=/opt/hud \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON

[build]
cd build && make -j$(nproc)

[install]
cd build && make DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ brotli 1.1.0 installed to /opt/hud"
