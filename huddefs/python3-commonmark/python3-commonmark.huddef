# HUD Package Definition - commonmark 0.9.1
# Based on BLFS 12.4
Package: python3-commonmark
Version: 0.9.1
Architecture: x86_64
Section: python
Description: Commonmark-0.9.1 - Python parser for CommonMark Markdown
Source: https://files.pythonhosted.org/packages/source/c/commonmark/commonmark-0.9.1.tar.gz
Source-SHA256:    452f9dc859be7f06631ddcb328b6919c67984aca654e5fefb3914d54691aed60

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist commonmark --break-system-packages

[postinst]
echo "python3-commonmark 0.9.1 installed"
