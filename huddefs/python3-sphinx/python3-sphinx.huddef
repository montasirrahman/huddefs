# HUD Package Definition - Sphinx 8.2.3
# Based on BLFS 12.4
Package: python3-sphinx
Version: 8.2.3
Architecture: x86_64
Section: python
Depends: python3,python3-alabaster,python3-babel,python3-docutils,python3-imagesize,python3-pygments,python3-requests,python3-roman-numerals-py,python3-snowballstemmer,python3-sphinxcontrib-applehelp,python3-sphinxcontrib-devhelp,python3-sphinxcontrib-htmlhelp,python3-sphinxcontrib-jsmath,python3-sphinxcontrib-qthelp,python3-sphinxcontrib-serializinghtml
Description: Sphinx-8.2.3 - tools for translating structured text formats into documentation
Source: https://files.pythonhosted.org/packages/source/s/sphinx/sphinx-8.2.3.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user sphinx
[postinst]
echo "python3-sphinx 8.2.3 installed"
[prerm]
pip3 uninstall -y sphinx 2>/dev/null || true
[postrm]
# Cleanup if needed
