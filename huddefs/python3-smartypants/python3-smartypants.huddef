# HUD Package Definition - smartypants 2.0.2
# Based on BLFS 12.4
Package: python3-smartypants
Version: 2.0.2
Architecture: x86_64
Section: python
Description: Smartypants-2.0.2 - translates ASCII punctuation to typographic HTML entities
Source: https://files.pythonhosted.org/packages/source/s/smartypants/smartypants-2.0.2.tar.gz
Source-SHA256:    39d64ce1d7cc6964b698297bdf391bc12c3251b7f608e6e55d857cd7c5f800c6

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist smartypants --break-system-packages

[postinst]
echo "python3-smartypants 2.0.2 installed"
