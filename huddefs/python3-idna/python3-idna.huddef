# HUD Package Definition - idna 3.10
# Based on BLFS 12.4
Package: python3-idna
Version: 3.10
Architecture: x86_64
Section: python
Description: Idna-3.10 - Internationalized Domain Names in Applications (IDNA) support
Source: https://files.pythonhosted.org/packages/source/i/idna/idna-3.10.tar.gz
Source-SHA256:    12f65c9b470abda6dc35cf8e63cc574b1c52b11df2c86030af0ac09b01b13ea9

Build-Depends:    python3, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist idna --break-system-packages

[postinst]
echo "python3-idna 3.10 installed"
