# HUD Package Definition - zlib 1.3.1
# Compression library
# Converted from v1 to v2 per docs/huddef-v2-spec.md

Package:          zlib
Version:          1.3.1
Architecture:     x86_64
Section:          libraries
Description:      A Massively Spiffy Yet Delicately Unobtrusive Compression Library

Source:           https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
Source-SHA256:    9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23

# zlib needs only the base toolchain (cc, make) already present in the build
# rootfs, so there is nothing to install before building.
Build-Depends:
Depends:          auto
Provides:         auto

[configure]
./configure \
    --prefix=/opt/hud \
    --libdir=/opt/hud/lib

[build]
make -j$NPROC

[install]
make DESTDIR=$DESTDIR install

[check]
test -f $DESTDIR/opt/hud/lib/libz.so.1.3.1
test -f $DESTDIR/opt/hud/lib/pkgconfig/zlib.pc
grep -q '#define ZLIB_VERSION "1.3.1"' $DESTDIR/opt/hud/include/zlib.h

[postinst]
ldconfig
