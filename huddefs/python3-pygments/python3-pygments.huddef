# HUD Package Definition - Pygments 2.19.2
# Based on BLFS 12.4
Package: python3-pygments
Version: 2.19.2
Architecture: x86_64
Section: python
Description: Pygments-2.19.2 - general syntax highlighter for 300+ languages
Source: https://files.pythonhosted.org/packages/source/P/Pygments/pygments-2.19.2.tar.gz
Source-SHA256:    636cb2477cec7f8952536970bc533bc43743542f70392ae026374600add5b887

Build-Depends:    python3, python3-hatchling
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist Pygments --break-system-packages

[postinst]
echo "python3-pygments 2.19.2 installed"
