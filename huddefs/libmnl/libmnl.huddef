# HUD Package Definition - libmnl 1.0.5
# Minimalistic Netlink library

Package: libmnl
Version: 1.0.5
Architecture: x86_64
Section: libraries
Description: Minimalistic user-space library for Netlink
Source: https://netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2
Source-SHA256:    274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure \
    --prefix=/opt/hud \
    --disable-static

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ libmnl 1.0.5 installed to /opt/hud"
