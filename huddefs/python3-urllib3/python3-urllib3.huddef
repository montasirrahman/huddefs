# HUD Package Definition - urllib3 2.5.0
# Based on BLFS 12.4
Package: python3-urllib3
Version: 2.5.0
Architecture: x86_64
Section: python
Description: Urllib3-2.5.0 - powerful, user-friendly HTTP client for Python
Source: https://files.pythonhosted.org/packages/source/u/urllib3/urllib3-2.5.0.tar.gz
Source-SHA256:    3fc47733c7e419d4bc3f6b3dc2b4f890bb743906a30d56ba4a5bfa4bbff92760

Build-Depends:    python3, python3-hatch-vcs, python3-hatchling, python3-setuptools-scm
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist urllib3 --break-system-packages

[postinst]
echo "python3-urllib3 2.5.0 installed"
