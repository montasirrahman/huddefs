# HUD Package Definition - urllib3 2.5.0
# Based on BLFS 12.4
Package: python3-urllib3
Version: 2.5.0
Architecture: x86_64
Section: python
Depends: python3,python3-hatch-vcs
Description: Urllib3-2.5.0 - powerful, user-friendly HTTP client for Python
Source: https://files.pythonhosted.org/packages/source/u/urllib3/urllib3-2.5.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user urllib3
[postinst]
echo "python3-urllib3 2.5.0 installed"
[prerm]
pip3 uninstall -y urllib3 2>/dev/null || true
[postrm]
# Cleanup if needed
