# HUD Package Definition - font-alias 1.0.5
# Standard X font aliases
Package: font-alias
Version: 1.0.5
Architecture: x86_64
Section: xorg-fonts
Depends: font-util
Description: Standard X font aliases
Source: https://www.x.org/pub/individual/font/font-alias-1.0.5.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ font-alias 1.0.5 installed to /opt/hud"
