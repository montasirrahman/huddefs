# HUD Package Definition - doxypypy 0.8.8.7
# Based on BLFS 12.4
Package: python3-doxypypy
Version: 0.8.8.7
Architecture: x86_64
Section: python
Description: Doxypypy-0.8.8.7 - doxygen filter for python
Source: https://files.pythonhosted.org/packages/source/d/doxypypy/doxypypy-0.8.8.7.tar.gz
Source-SHA256:    671ac8bb06927b78a924726187f6e3dde272ae960856ffc053e6e5bea42cd09e

Build-Depends:    python3, python3-chardet, doxygen, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist doxypypy --break-system-packages

[postinst]
echo "python3-doxypypy 0.8.8.7 installed"
