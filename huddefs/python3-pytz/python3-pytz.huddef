# HUD Package Definition - pytz 2025.2
# Based on BLFS 12.4
Package: python3-pytz
Version: 2025.2
Architecture: x86_64
Section: python
Depends: python3
Description: Pytz-2025.2 - brings IANA tz database into Python
Source: https://files.pythonhosted.org/packages/source/p/pytz/pytz-2025.2.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user pytz
[postinst]
echo "python3-pytz 2025.2 installed"
[prerm]
pip3 uninstall -y pytz 2>/dev/null || true
[postrm]
# Cleanup if needed
