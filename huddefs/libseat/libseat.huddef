# HUD Package Definition - libseat 0.9.1
# Seat management library
Package: libseat
Version: 0.9.1
Architecture: x86_64
Section: system
Description: Seat management library for Wayland compositors
Source: https://git.sr.ht/~kennylevinsen/seatd/archive/0.9.1.tar.gz
Source-SHA256:    819979c922a0be258aed133d93920bce6a3d3565a60588d6d372ce9db2712cd3

Build-Depends:    meson, ninja
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release -Dexamples=disabled -Dman-pages=disabled ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ libseat 0.9.1 installed to /opt/hud"
/sbin/ldconfig
