# HUD Package Definition - certifi 2025.8.3
# Based on BLFS 12.4
Package: python3-certifi
Version: 2025.8.3
Architecture: x86_64
Section: python
Description: certifi-2025.8.3 - Mozilla's Root Certificates for SSL validation
Source: https://files.pythonhosted.org/packages/source/c/certifi/certifi-2025.8.3.tar.gz
Source-SHA256:    e564105f78ded564e3ae7c923924435e1daa7463faeab5bb932bc53ffae63407

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist certifi --break-system-packages

[postinst]
echo "python3-certifi 2025.8.3 installed"
