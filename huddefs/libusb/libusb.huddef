# HUD Package Definition - libusb 1.0.28
# USB device access library

Package: libusb
Version: 1.0.28
Architecture: x86_64
Section: libraries
Description: Library for USB device access
Source: https://github.com/libusb/libusb/releases/download/v1.0.28/libusb-1.0.28.tar.bz2
Source-SHA256:    966bb0d231f94a474eaae2e67da5ec844d3527a1f386456394ff432580634b29

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud --disable-static

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ libusb 1.0.28 installed to /opt/hud"
