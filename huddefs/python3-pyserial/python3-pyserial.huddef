# HUD Package Definition - pySerial 3.5
# Based on BLFS 12.4
Package: python3-pyserial
Version: 3.5
Architecture: x86_64
Section: python
Description: pySerial-3.5 - encapsulates access to the serial port
Source: https://files.pythonhosted.org/packages/source/p/pyserial/pyserial-3.5.tar.gz
Source-SHA256:    3c77e014170dfffbd816e6ffc205e9842efb10be9f58ec16d3e8675b4925cddb

Build-Depends:    python3, python3-setuptools-scm, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pyserial --break-system-packages

[postinst]
echo "python3-pyserial 3.5 installed"
