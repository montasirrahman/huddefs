# HUD Package Definition - dbus-python 1.3.2
# Python bindings for D-Bus
# Required by firewalld and other Python D-Bus applications

Package: dbus-python
Version: 1.3.2
Architecture: x86_64
Section: python
Description: Python bindings for D-Bus interprocess communication
Source: https://dbus.freedesktop.org/releases/dbus-python/dbus-python-1.3.2.tar.gz
Source-SHA256:    ad67819308618b5069537be237f8e68ca1c7fcc95ee4a121fe6845b1418248f8

Build-Depends:    dbus, python3, glib
Depends:          auto
Provides:         auto

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/lib64/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"
export PYTHON=/usr/bin/python3
mkdir -p build
cd build
meson setup ..                          \
      --prefix=/opt/hud                 \
      --buildtype=release               \
      -D python=/usr/bin/python3        \
      -D doc=false                      \
      -D tests=false

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
cd build
ninja

[install]
cd build
DESTDIR=$DESTDIR ninja install

[postinst]
ldconfig
echo "dbus-python 1.3.2 installed"
echo "Test with: python3 -c \"import dbus; print(dbus.version)\""
