# HUD Package Definition - sphinx_rtd_theme 3.0.2
# Based on BLFS 12.4
Package: python3-sphinx-rtd-theme
Version: 3.0.2
Architecture: x86_64
Section: python
Description: sphinx_rtd_theme-3.0.2 - Sphinx theme for Read the Docs
Source: https://files.pythonhosted.org/packages/source/s/sphinx_rtd_theme/sphinx_rtd_theme-3.0.2.tar.gz
Source-SHA256:    b7457bc25dda723b20b086a670b9953c859eab60a2a03ee8eb2bb23e176e5f85

Build-Depends:    python3, python3-sphinx, python3-sphinxcontrib-jquery, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist sphinx_rtd_theme --break-system-packages

[postinst]
echo "python3-sphinx-rtd-theme 3.0.2 installed"
