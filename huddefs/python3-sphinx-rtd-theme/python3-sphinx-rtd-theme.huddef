# HUD Package Definition - sphinx_rtd_theme 3.0.2
# Based on BLFS 12.4
Package: python3-sphinx-rtd-theme
Version: 3.0.2
Architecture: x86_64
Section: python
Depends: python3,python3-sphinx,python3-sphinxcontrib-jquery
Description: sphinx_rtd_theme-3.0.2 - Sphinx theme for Read the Docs
Source: https://files.pythonhosted.org/packages/source/s/sphinx_rtd_theme/sphinx_rtd_theme-3.0.2.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user sphinx_rtd_theme
[postinst]
echo "python3-sphinx-rtd-theme 3.0.2 installed"
[prerm]
pip3 uninstall -y sphinx_rtd_theme 2>/dev/null || true
[postrm]
# Cleanup if needed
