# HUD Package Definition - pluggy 1.6.0
# Based on BLFS 12.4
Package: python3-pluggy
Version: 1.6.0
Architecture: x86_64
Section: python
Description: Pluggy-1.6.0 - enables function hooking for pluggable systems
Source: https://files.pythonhosted.org/packages/source/p/pluggy/pluggy-1.6.0.tar.gz
Source-SHA256:    7dcc130b76258d33b90f61b658791dede3486c3e6bfb003ee5c9bfb396dd22f3

Build-Depends:    python3, python3-setuptools-scm, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pluggy --break-system-packages

[postinst]
echo "python3-pluggy 1.6.0 installed"
