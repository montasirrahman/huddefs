# HUD Package Definition - msgpack 1.1.1
# Based on BLFS 12.4
Package: python3-msgpack
Version: 1.1.1
Architecture: x86_64
Section: python
Description: Msgpack-1.1.1 - efficient binary serialization format
Source: https://files.pythonhosted.org/packages/source/m/msgpack/msgpack-1.1.1.tar.gz
Source-SHA256:    77b79ce34a2bdab2594f490c8e80dd62a02d650b91a75159a63ec413b8d104cd

Build-Depends:    python3, python3-cython, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist msgpack --break-system-packages

[postinst]
echo "python3-msgpack 1.1.1 installed"
