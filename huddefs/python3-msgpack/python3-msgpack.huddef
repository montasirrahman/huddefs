# HUD Package Definition - msgpack 1.1.1
# Based on BLFS 12.4
Package: python3-msgpack
Version: 1.1.1
Architecture: x86_64
Section: python
Depends: python3,python3-cython
Description: Msgpack-1.1.1 - efficient binary serialization format
Source: https://files.pythonhosted.org/packages/source/m/msgpack/msgpack-1.1.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user msgpack
[postinst]
echo "python3-msgpack 1.1.1 installed"
[prerm]
pip3 uninstall -y msgpack 2>/dev/null || true
[postrm]
# Cleanup if needed
