# HUD Package Definition - giflib 5.2.2
# GIF image library - Based on LFS 12.4
# Note: Uses plain Makefile, requires patches

Package: giflib
Version: 5.2.2
Architecture: x86_64
Section: libraries
Depends:
Description: Library for reading and writing GIF images
Source: https://sourceforge.net/projects/giflib/files/giflib-5.2.2.tar.gz
Patches:          giflib-5.2.2-upstream_fixes-1.patch, giflib-5.2.2-security_fixes-1.patch

[configure]
# Both patches are applied by the builder from patches/, in the order the
# Patches: header lists them, before this section runs. v1 fetched them here
# with wget — which is not installed on any of these machines, so the download
# failed, and unlike qemu's these were not guarded with `|| true`. One of the
# two is the security fix.

# Move file to expected location (removes ImageMagick dependency)
cp pic/gifgrid.gif doc/giflib-logo.gif

[build]
make -j$(nproc)

[install]
make PREFIX=/opt/hud DESTDIR=$DESTDIR install
# Remove static library
rm -fv $DESTDIR/opt/hud/lib/libgif.a

[postinst]
ldconfig 2>/dev/null || true
echo "✓ giflib 5.2.2 installed to /opt/hud"
