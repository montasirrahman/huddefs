# HUD Package Definition - build 1.3.0
# Based on BLFS 12.4
Package: python3-build
Version: 1.3.0
Architecture: x86_64
Section: python
Description: build-1.3.0 - Python build frontend implementing PEP-517
Source: https://files.pythonhosted.org/packages/source/b/build/build-1.3.0.tar.gz
Source-SHA256:    698edd0ea270bde950f53aed21f3a0135672206f3911e0176261a31e0e07b397

Build-Depends:    python3, python3-pyproject-hooks, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist build --break-system-packages

[postinst]
echo "python3-build 1.3.0 installed"
