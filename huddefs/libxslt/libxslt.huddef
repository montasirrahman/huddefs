# HUD Package Definition - libxslt 1.1.43
# Auto-generated for oVirt infrastructure

Package: libxslt
Version: 1.1.43
Architecture: x86_64
Section: libraries
Depends: libxml2,docbook,libgcrypt,docbook-xsl
