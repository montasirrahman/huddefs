# HUD Package Definition - hatch_vcs 0.5.0
# Based on BLFS 12.4
Package: python3-hatch-vcs
Version: 0.5.0
Architecture: x86_64
Section: python
Description: hatch_vcs-0.5.0 - Hatch plugin for versioning with VCS
Source: https://files.pythonhosted.org/packages/source/h/hatch-vcs/hatch_vcs-0.5.0.tar.gz
Source-SHA256:    0395fa126940340215090c344a2bf4e2a77bcbe7daab16f41b37b98c95809ff9

Build-Depends:    python3, python3-hatchling, python3-setuptools-scm
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist hatch_vcs --break-system-packages

[postinst]
echo "python3-hatch-vcs 0.5.0 installed"
