# HUD Package Definition - nodejs 22.18.0
# Auto-generated for oVirt infrastructure

Package: nodejs
Version: 22.18.0
Architecture: x86_64
Section: development
Description: Node.js-22.18.0
Source: https://nodejs.org/dist/v22.18.0/node-v22.18.0.tar.xz
Source-SHA256:    120e0f74419097a9fafae1fd80b9de7791a587e6f1c48c22b193239ccd0f7084

Build-Depends:    nghttp2, icu, make-ca, brotli, which
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud --shared-openssl --shared-zlib

[build]
make -j$(nproc)

[install]
# DESTDIR is exported by the builder, so `make install` stages correctly.
make install &&

# The versioned documentation alias. v1 wrote it to /usr/share/doc on the build
# host — outside $DESTDIR, so it never shipped, and outside the prefix, so it
# would not have belonged to the package if it had.
ln -sfn node $DESTDIR/opt/hud/share/doc/node-22.18.0

[postinst]
ldconfig 2>/dev/null || true
echo "nodejs 22.18.0 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
