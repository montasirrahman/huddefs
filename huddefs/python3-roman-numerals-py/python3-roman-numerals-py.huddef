# HUD Package Definition - roman-numerals-py 3.1.0
# Based on BLFS 12.4
Package: python3-roman-numerals-py
Version: 3.1.0
Architecture: x86_64
Section: python
Description: roman-numerals-py-3.1.0 - library for manipulating Roman numerals
Source: https://files.pythonhosted.org/packages/source/r/roman-numerals-py/roman_numerals_py-3.1.0.tar.gz
Source-SHA256:    be4bf804f083a4ce001b5eb7e3c0862479d10f94c936f6c4e5f250aa5ff5bd2d

Build-Depends:    python3, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist roman-numerals-py --break-system-packages

[postinst]
echo "python3-roman-numerals-py 3.1.0 installed"
