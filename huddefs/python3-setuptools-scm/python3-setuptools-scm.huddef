# HUD Package Definition - setuptools_scm 8.3.1
# Based on BLFS 12.4
Package: python3-setuptools-scm
Version: 8.3.1
Architecture: x86_64
Section: python
Depends: python3
Description: setuptools_scm-8.3.1 - extract Python package versions from git or hg metadata
Source: https://files.pythonhosted.org/packages/source/s/setuptools_scm/setuptools_scm-8.3.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user setuptools_scm
[postinst]
echo "python3-setuptools-scm 8.3.1 installed"
[prerm]
pip3 uninstall -y setuptools_scm 2>/dev/null || true
[postrm]
# Cleanup if needed
