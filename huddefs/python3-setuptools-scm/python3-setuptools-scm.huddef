# HUD Package Definition - setuptools_scm 8.3.1
# Based on BLFS 12.4
Package: python3-setuptools-scm
Version: 8.3.1
Architecture: x86_64
Section: python
Description: setuptools_scm-8.3.1 - extract Python package versions from git or hg metadata
Source: https://files.pythonhosted.org/packages/source/s/setuptools_scm/setuptools_scm-8.3.1.tar.gz
Source-SHA256:    3d555e92b75dacd037d32bafdf94f97af51ea29ae8c7b234cf94b7a5bd242a63

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist setuptools_scm --break-system-packages

[postinst]
echo "python3-setuptools-scm 8.3.1 installed"
