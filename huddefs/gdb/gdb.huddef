# HUD Package Definition - gdb 16.3
# Auto-generated for oVirt infrastructure

Package: gdb
Version: 16.3
Architecture: x86_64
Section: development
Description: GDB-16.3
Source: https://ftp.gnu.org/gnu/gdb/gdb-16.3.tar.xz
Source-SHA256:    bcfcd095528a987917acf9fff3f1672181694926cc18d609c99d0042c00224c5

Build-Depends:    valgrind
Depends:          auto
Provides:         auto

[configure]
# GCC 15 defaults to C23; gdb 16.3 predates that and fails to build against it.
# -std=gnu17 is the conventional fix and changes nothing about what ships.
export CFLAGS="${CFLAGS:-} -std=gnu17"
./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make install

[postinst]
ldconfig 2>/dev/null || true
echo "gdb 16.3 installed to /opt/hud"

[prerm]
# Stop service if running

[postrm]
ldconfig 2>/dev/null || true
