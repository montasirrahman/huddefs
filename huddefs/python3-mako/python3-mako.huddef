# HUD Package Definition - Mako 1.3.10
# Based on BLFS 12.4
Package: python3-mako
Version: 1.3.10
Architecture: x86_64
Section: python
Depends: python3
Description: Mako-1.3.10 - hyperfast and lightweight templating for Python
Source: https://files.pythonhosted.org/packages/source/M/Mako/mako-1.3.10.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user Mako
[postinst]
echo "python3-mako 1.3.10 installed"
[prerm]
pip3 uninstall -y Mako 2>/dev/null || true
[postrm]
# Cleanup if needed
