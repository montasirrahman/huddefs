# HUD Package Definition - Mako 1.3.10
# Based on BLFS 12.4
Package: python3-mako
Version: 1.3.10
Architecture: x86_64
Section: python
Description: Mako-1.3.10 - hyperfast and lightweight templating for Python
Source: https://files.pythonhosted.org/packages/source/M/Mako/mako-1.3.10.tar.gz
Source-SHA256:    99579a6f39583fa7e5630a28c3c1f440e4e97a414b80372649c0ce338da2ea28

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist Mako --break-system-packages

[postinst]
echo "python3-mako 1.3.10 installed"
