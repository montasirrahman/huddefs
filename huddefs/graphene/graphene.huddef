# HUD Package Definition - graphene 1.10.8
# Thin layer of graphic data types
Package: graphene
Version: 1.10.8
Architecture: x86_64
Section: graphics
Description: Thin layer of graphic data types for GTK4
Source: https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz
Source-SHA256:    a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a


Build-Depends:    glib, meson, ninja, python-setuptools
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release -Dinstalled_tests=false ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ graphene 1.10.8 installed to /opt/hud"
/sbin/ldconfig
