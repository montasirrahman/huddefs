# HUD Package Definition - libgudev 238
# GObject bindings for libudev

Package: libgudev
Version: 238
Architecture: x86_64
Section: libraries
Depends: glib2
Description: GObject bindings for libudev
Source: https://download.gnome.org/sources/libgudev/238/libgudev-238.tar.xz

[configure]
mkdir -p build && cd build && meson setup .. \
    --prefix=/opt/hud \
    -Dintrospection=disabled \
    -Dtests=disabled \
    -Dvapi=disabled

[build]
cd build && ninja -j$(nproc)

[install]
cd build && DESTDIR=$DESTDIR ninja install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ libgudev 238 installed to /opt/hud"
