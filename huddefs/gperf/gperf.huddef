# HUD Package Definition - gperf 3.1
# Perfect hash function generator

Package: gperf
Version: 3.1
Architecture: x86_64
Section: development
Description: Perfect hash function generator
Source: https://ftp.gnu.org/gnu/gperf/gperf-3.1.tar.gz
Source-SHA256:    588546b945bba4b70b6a3a616e80b4ab466e3f33024a352fc2198112cdbb3ae2

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
echo "✓ gperf 3.1 installed to /opt/hud"
