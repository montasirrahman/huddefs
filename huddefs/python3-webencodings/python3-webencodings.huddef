# HUD Package Definition - webencodings 0.5.1
# Based on BLFS 12.4
Package: python3-webencodings
Version: 0.5.1
Architecture: x86_64
Section: python
Description: webencodings-0.5.1 - Python implementation of WHATWG Encoding standard
Source: https://files.pythonhosted.org/packages/source/w/webencodings/webencodings-0.5.1.tar.gz
Source-SHA256:    b36a1c245f2d304965eb4e0a82848379241dc04b865afcc4aab16748587e1923

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist webencodings --break-system-packages

[postinst]
echo "python3-webencodings 0.5.1 installed"
