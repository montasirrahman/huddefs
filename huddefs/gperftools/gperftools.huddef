# HUD Package Definition - gperftools 2.16
# Google Performance Tools (includes tcmalloc)
# Required by: glusterfs (tcmalloc library)
# Reference: https://github.com/gperftools/gperftools

Package: gperftools
Version: 2.16
Architecture: x86_64
Section: libraries
Depends: 
Description: Google Performance Tools (tcmalloc, heap profiler, etc)
Source: https://github.com/gperftools/gperftools/releases/download/gperftools-2.16/gperftools-2.16.tar.gz

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export CXXFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

./configure --prefix=/opt/hud \
            --libdir=/opt/hud/lib64 \
            --enable-shared \
            --enable-static \
            --enable-frame-pointers

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

# Compatibility symlinks and the loader drop-in.
#
# v1 created a partial set here and then a fuller, different set in [postinst] —
# untracked, and pointing at /opt/hud/lib64/libtcmalloc.so.4.6.16, a fully
# versioned name that changes with every release. The [postinst] copies won and
# `hud remove` left all six behind. One set, staged, aimed at the sonames.
install -v -dm755 $DESTDIR/usr/lib64
for l in libtcmalloc libtcmalloc_minimal libtcmalloc_and_profiler; do
    ln -sfn /opt/hud/lib64/$l.so.4 $DESTDIR/usr/lib64/$l.so.4
    ln -sfn $l.so.4               $DESTDIR/usr/lib64/$l.so
done

# The loader configuration. v1 wrote it from [postinst] with a redirect, so it
# was untracked and outlived the package.
install -v -dm755 $DESTDIR/etc/ld.so.conf.d
echo "/opt/hud/lib64" > $DESTDIR/etc/ld.so.conf.d/gperftools.conf

[postinst]
# Everything this used to create is shipped by [install] now. ldconfig stays: it
# rebuilds a cache rather than creating a file the package should own.
ldconfig

echo ""
echo "============================================"
echo "gperftools 2.16 installed successfully"
echo "============================================"
echo ""
echo "Libraries provided:"
echo "  - libtcmalloc.so (high-performance malloc)"
echo "  - libtcmalloc_minimal.so (minimal version)"
echo "  - libtcmalloc_and_profiler.so (with profiling)"
echo "  - libprofiler.so (CPU profiler)"
echo "  - libtcmalloc_debug.so (debug version)"
echo ""
echo "Usage:"
echo "  Link with: -ltcmalloc"
echo "  Or preload: LD_PRELOAD=/opt/hud/lib64/libtcmalloc.so"
echo ""
