# HUD Package Definition - libdrm 2.4.124
# Direct Rendering Manager library
Package: libdrm
Version: 2.4.124
Architecture: x86_64
Section: graphics
Description: Direct Rendering Manager runtime library
Source: https://dri.freedesktop.org/libdrm/libdrm-2.4.124.tar.xz
Source-SHA256:    ac36293f61ca4aafaf4b16a2a7afff312aa4f5c37c9fbd797de9e3c0863ca379

Build-Depends:    libpciaccess, meson, ninja
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release -Dudev=true -Dvalgrind=disabled ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ libdrm 2.4.124 installed to /opt/hud"
/sbin/ldconfig
