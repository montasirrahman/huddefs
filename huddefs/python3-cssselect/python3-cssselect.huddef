# HUD Package Definition - cssselect 1.3.0
# Based on BLFS 12.4
Package: python3-cssselect
Version: 1.3.0
Architecture: x86_64
Section: python
Description: CSSSelect-1.3.0 - CSS selectors for Python
Source: https://files.pythonhosted.org/packages/source/c/cssselect/cssselect-1.3.0.tar.gz
Source-SHA256:    57f8a99424cfab289a1b6a816a43075a4b00948c86b4dcf3ef4ee7e15f7ab0c7

Build-Depends:    python3, python3-setuptools-scm, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist cssselect --break-system-packages

[postinst]
echo "python3-cssselect 1.3.0 installed"
