# HUD Package Definition - nftables 1.1.1
# Netfilter tables - modern Linux firewall subsystem
# Required by firewalld and libvirt for packet filtering
# Reference: https://netfilter.org/projects/nftables/
#
# KERNEL REQUIREMENTS:
# The following kernel options must be enabled:
#   CONFIG_NF_TABLES=y
#   CONFIG_NF_TABLES_INET=y (CRITICAL - inet family support)
#   CONFIG_NF_TABLES_NETDEV=y
#   CONFIG_NFT_CT=m
#   CONFIG_NFT_LOG=m
#   CONFIG_NFT_LIMIT=m
#   CONFIG_NFT_MASQ=m
#   CONFIG_NFT_NAT=m
#   CONFIG_NFT_REJECT=m
#   CONFIG_NFT_COMPAT=m
#   CONFIG_NFT_COUNTER=y (built-in recommended)

Package: nftables
Version: 1.1.1
Architecture: x86_64
Section: network
Description: Netfilter tables userspace tools (modern iptables replacement)
Source: https://www.netfilter.org/projects/nftables/files/nftables-1.1.1.tar.xz
Source-SHA256:    6358830f3a64f31e39b0ad421d7dadcd240b72343ded48d8ef13b8faf204865a

# libedit: configure fails with "No suitable version of libedit found" without
# it. nft's interactive mode is built by default and needs the line editor.
Build-Depends:    libnftnl, libmnl, readline, gmp, jansson, libedit
Depends:          auto
Provides:         auto

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"
./configure --prefix=/opt/hud          \
            --sysconfdir=/etc          \
            --localstatedir=/var       \
            --with-json                \
            --with-python-bin=/usr/bin/python3 \
            --enable-python

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
make -j$(nproc)

[install]
DESTDIR=$DESTDIR make install

# Moved out of [postinst] by docs/file-ownership-policy.md:
# anything created there is untracked and survives `hud remove`.
install -v -dm755 $DESTDIR/usr/sbin
ln -sfn /opt/hud/sbin/nft $DESTDIR/usr/sbin/nft

install -v -dm755 $DESTDIR/sbin
ln -sfn /opt/hud/sbin/nft $DESTDIR/sbin/nft

install -v -dm755 $DESTDIR/etc/nftables

install -v -dm755 $DESTDIR/opt/hud/share/nftables/defaults
cat > $DESTDIR/opt/hud/share/nftables/defaults/nftables.conf << "EOF"
#!/usr/sbin/nft -f
# Basic nftables configuration
# Managed by firewalld when firewalld is running

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy accept;
    }
    chain forward {
        type filter hook forward priority 0; policy accept;
    }
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
EOF

[postinst]
ldconfig

# Add library path to system ldconfig
echo "/opt/hud/lib" > /etc/ld.so.conf.d/hud.conf
echo "/opt/hud/lib64" >> /etc/ld.so.conf.d/hud.conf
ldconfig

# Create symlinks

# Create basic nftables config

echo ""
echo "nftables 1.1.1 installed"
echo "Binary: /opt/hud/sbin/nft (symlinked to /usr/sbin/nft)"
echo ""
echo "Test: nft list tables"
echo "Note: firewalld manages nftables rules when running"

# /etc/nftables/nftables.conf: ship a default, never clobber an edited file.
if [ ! -e /etc/nftables/nftables.conf ]; then
    install -v -Dm644 /opt/hud/share/nftables/defaults/nftables.conf /etc/nftables/nftables.conf
fi
