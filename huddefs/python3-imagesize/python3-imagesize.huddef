# HUD Package Definition - imagesize 1.4.1
# Based on BLFS 12.4
Package: python3-imagesize
Version: 1.4.1
Architecture: x86_64
Section: python
Depends: python3
Description: imagesize-1.4.1 - analyzes image file headers and returns size and DPI
Source: https://files.pythonhosted.org/packages/source/i/imagesize/imagesize-1.4.1.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user imagesize
[postinst]
echo "python3-imagesize 1.4.1 installed"
[prerm]
pip3 uninstall -y imagesize 2>/dev/null || true
[postrm]
# Cleanup if needed
