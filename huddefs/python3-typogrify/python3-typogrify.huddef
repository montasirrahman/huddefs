# HUD Package Definition - typogrify 2.1.0
# Based on BLFS 12.4
Package: python3-typogrify
Version: 2.1.0
Architecture: x86_64
Section: python
Description: Typogrify-2.1.0 - filters to enhance web typography
Source: https://files.pythonhosted.org/packages/source/t/typogrify/typogrify-2.1.0.tar.gz
Source-SHA256:    f0aa004e98032a6e6be4c9da65e7eb7150e36ca3bf508adbcda82b4d003e61ee

Build-Depends:    python3, python3-hatchling, python3-smartypants
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist typogrify --break-system-packages

[postinst]
echo "python3-typogrify 2.1.0 installed"
