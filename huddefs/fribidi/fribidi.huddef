# HUD Package Definition - fribidi 1.0.16
# Unicode Bidirectional Algorithm library
Package: fribidi
Version: 1.0.16
Architecture: x86_64
Section: graphics
Description: Implementation of the Unicode Bidirectional Algorithm
Source: https://github.com/fribidi/fribidi/releases/download/v1.0.16/fribidi-1.0.16.tar.xz
Source-SHA256:    1b1cde5b235d40479e91be2f0e88a309e3214c8ab470ec8a2744d82a5a9ea05c

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ fribidi 1.0.16 installed to /opt/hud"
/sbin/ldconfig
