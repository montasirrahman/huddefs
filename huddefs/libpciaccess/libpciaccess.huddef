# HUD Package Definition - libpciaccess 0.18.1
# Generic PCI Access library for X
Package: libpciaccess
Version: 0.18.1
Architecture: x86_64
Section: xorg
Description: Generic PCI Access library for X
Source: https://www.x.org/pub/individual/lib/libpciaccess-0.18.1.tar.xz
Source-SHA256:    4af43444b38adb5545d0ed1c2ce46d9608cc47b31c2387fc5181656765a6fa76

Build-Depends:    util-macros
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
meson setup --prefix=/opt/hud --buildtype=release ..
[build]
cd build
ninja
[install]
cd build
DESTDIR=$DESTDIR ninja install
[postinst]
echo "✓ libpciaccess 0.18.1 installed to /opt/hud"
/sbin/ldconfig
