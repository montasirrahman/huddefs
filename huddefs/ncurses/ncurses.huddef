# HUD Package Definition - ncurses 6.5-20250809
# Terminal handling library - Based on LFS 12.4-systemd
# Updated version with GCC 15 compatibility

Package: ncurses
Version: 6.5.20250809
Architecture: x86_64
Section: libraries
Description: New curses library - terminal handling (LFS 12.4)
Source: https://invisible-mirror.net/archives/ncurses/current/ncurses-6.5-20250809.tgz
Source-SHA256:    b071468b8c79099a378ed9bea937a605509f71e720402e2541abe20ad753c555


Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure \
    --prefix=/opt/hud \
    --mandir=/opt/hud/share/man \
    --with-manpage-format=normal \
    --with-shared \
    --without-normal \
    --with-cxx-shared \
    --without-debug \
    --without-ada \
    --enable-widec \
    --enable-pc-files \
    --with-pkg-config-libdir=/opt/hud/lib/pkgconfig \
    AWK=gawk

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

# Create libncurses.so symlink (needed by some packages)
ln -sfv libncursesw.so $DESTDIR/opt/hud/lib/libncurses.so

# Fix curses.h to always use wide-character data structures.
#
# The path was $DESTDIR/opt/hud/include/curses.h, which does not exist and
# cannot: --enable-widec makes ncurses install its headers into
# include/ncursesw/, and include/ncurses is a symlink to that directory. The
# build therefore died with
#     sed: can't read /dest/opt/hud/include/curses.h: No such file or directory
# every time, and the published ncurses was built by some other means.
sed -e 's/^#if.*XOPEN.*$/#if 1/' \
    -i $DESTDIR/opt/hud/include/ncursesw/curses.h

# A top-level curses.h and ncurses.h, for the many packages that include
# <curses.h> without knowing about the widec layout. util-linux is the reason
# this matters: its configure probes for ncursesw/ncurses.h and falls back to
# narrow curses when it cannot find a usable header, after which get_wch is an
# implicit declaration and GCC 15 makes that an error.
ln -sfv ncursesw/curses.h  $DESTDIR/opt/hud/include/curses.h
ln -sfv ncursesw/ncurses.h $DESTDIR/opt/hud/include/ncurses.h

# Create non-wide character compatibility symlinks
for lib in ncurses form panel menu; do
    rm -f $DESTDIR/opt/hud/lib/lib${lib}.so
    echo "INPUT(-l${lib}w)" > $DESTDIR/opt/hud/lib/lib${lib}.so
    ln -sfv lib${lib}w.a $DESTDIR/opt/hud/lib/lib${lib}.a 2>/dev/null || true
done

# The include directory symlink. Unguarded: if this fails the package is wrong,
# and `|| true` would ship it anyway.
ln -sfn ncursesw $DESTDIR/opt/hud/include/ncurses

# Create pkg-config symlinks for non-wide versions
for pc in ncurses form panel menu; do
    [ -f $DESTDIR/opt/hud/lib/pkgconfig/${pc}w.pc ] && \
    ln -sfv ${pc}w.pc $DESTDIR/opt/hud/lib/pkgconfig/${pc}.pc 2>/dev/null || true
done

[postinst]
ldconfig 2>/dev/null || true
echo "✓ ncurses 6.5-20250809 installed to /opt/hud"
