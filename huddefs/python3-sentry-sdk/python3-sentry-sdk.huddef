# HUD Package Definition - sentry-sdk 2.35.0
# Based on BLFS 12.4
Package: python3-sentry-sdk
Version: 2.35.0
Architecture: x86_64
Section: python
Depends: python3,python3-certifi,python3-urllib3
Description: sentry-sdk-2.35.0 - official Python SDK for Sentry.io
Source: https://github.com/getsentry/sentry-python/releases/download/2.35.0/sentry_sdk-2.35.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user sentry-sdk
[postinst]
echo "python3-sentry-sdk 2.35.0 installed"
[prerm]
pip3 uninstall -y sentry-sdk 2>/dev/null || true
[postrm]
# Cleanup if needed
