# HUD Package Definition - xmlto 0.0.29
# XML to Other Formats Converter
# Front-end to XSL toolchain for document conversion

Package: xmlto
Version: 0.0.29
Architecture: x86_64
Section: xml
Description: Front-end to XSL toolchain for converting XML to other formats
Source: https://pagure.io/xmlto/archive/0.0.29/xmlto-0.0.29.tar.gz
Source-SHA256:    40504db68718385a4eaa9154a28f59e51e59d006d1aa14f5bc9d6fded1d6017a

Build-Depends:    docbook-xsl, libxslt
# docbook is a RUNTIME dependency that no scan can find. xmlto is a shell
# script; its capabilities are exec(bash) and exec(xsltproc), and nothing in it
# names the DocBook XML DTD it cannot convert a document without. git builds its
# manual with xmlto, so an xmlto that installs without the DTD fails at the
# point of use rather than at install. The stale index row named "docbook-xml",
# which is not what the package is called and therefore resolved to nothing.
Depends:          auto, docbook
Provides:         auto

[configure]
autoreconf -fiv

LINKS="/usr/bin/links" ./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
echo "✓ xmlto 0.0.29 installed to /opt/hud"
