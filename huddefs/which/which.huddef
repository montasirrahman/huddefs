# HUD Package Definition - which 2.23
# Command Locator
# Shows full path of shell commands

Package: which
Version: 2.23
Architecture: x86_64
Section: utilities
Description: Utility to show the full path of shell commands installed in PATH
Source: https://ftp.gnu.org/gnu/which/which-2.23.tar.gz
Source-SHA256:    a2c558226fc4d9e4ce331bd2fd3c3f17f955115d2c00e447618a4ef9978a2a73

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
echo "✓ which 2.23 installed to /opt/hud"
