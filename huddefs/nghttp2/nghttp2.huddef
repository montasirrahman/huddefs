# HUD Package Definition - nghttp2 1.66.0
# Auto-generated for oVirt infrastructure

Package: nghttp2
Version: 1.66.0
Architecture: x86_64
Section: misc
Depends: libxml2,jansson,c-ares,sphinx
Description: nghttp2-1.66.0
