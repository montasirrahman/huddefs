# HUD Package Definition - requests 2.32.5
# Based on BLFS 12.4
Package: python3-requests
Version: 2.32.5
Architecture: x86_64
Section: python
Description: Requests-2.32.5 - elegant and simple HTTP library for Python
Source: https://files.pythonhosted.org/packages/source/r/requests/requests-2.32.5.tar.gz
Source-SHA256:    dbba0bac56e100853db0ea71b82b4dfd5fe2bf6d3754a8893c3af500cec7d7cf

Build-Depends:    python3, python3-charset-normalizer, python3-idna, python3-urllib3, python-setuptools
Depends:          auto
Provides:         auto
Patches:          requests-use_system_certs-1.patch

# The patch is applied by the builder from patches/, before [configure].
# v1 named it as a URL in a `Patch:` header and then ran `patch -Np1 -i
# ../requests-...`, against a file nothing had downloaded — so it never
# applied and the shipped package bundles certifi rather than using the
# system certificate store.
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist requests --break-system-packages

[postinst]
echo "python3-requests 2.32.5 installed"
