# HUD Package Definition - hatchling 1.27.0
# Based on BLFS 12.4
Package: python3-hatchling
Version: 1.27.0
Architecture: x86_64
Section: python
Depends: python3,python3-editables,python3-pathspec,python3-pluggy,python3-trove-classifiers
Description: Hatchling-1.27.0 - extensible, standards compliant build backend
Source: https://files.pythonhosted.org/packages/source/h/hatchling/hatchling-1.27.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user hatchling
[postinst]
echo "python3-hatchling 1.27.0 installed"
[prerm]
pip3 uninstall -y hatchling 2>/dev/null || true
[postrm]
# Cleanup if needed
