# HUD Package Definition - hatchling 1.27.0
# Based on BLFS 12.4
Package: python3-hatchling
Version: 1.27.0
Architecture: x86_64
Section: python
Description: Hatchling-1.27.0 - extensible, standards compliant build backend
Source: https://files.pythonhosted.org/packages/source/h/hatchling/hatchling-1.27.0.tar.gz
Source-SHA256:    971c296d9819abb3811112fc52c7a9751c8d381898f36533bb16f9791e941fd6

Build-Depends:    python3, python3-editables, python3-pathspec, python3-pluggy, python3-trove-classifiers, python3-packaging
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist hatchling --break-system-packages

[postinst]
echo "python3-hatchling 1.27.0 installed"
