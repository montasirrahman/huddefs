# HUD Package Definition - libedit 20240808-3.1
# BSD editline/history library (readline alternative)
# Required by nftables

Package: libedit
Version: 20240808
Architecture: x86_64
Section: libraries
Description: BSD editline and history libraries (readline alternative)
Source: https://thrysoee.dk/editline/libedit-20240808-3.1.tar.gz
Source-SHA256:    5f0573349d77c4a48967191cdd6634dd7aa5f6398c6a57fe037cc02696d6099f

Build-Depends:    ncurses
Depends:          auto
Provides:         auto

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/lib64/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"
./configure --prefix=/opt/hud

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
make

[install]
DESTDIR=$DESTDIR make install

[postinst]
ldconfig
echo "libedit 20240808 installed"
