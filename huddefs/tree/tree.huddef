# HUD Package Definition - tree 2.2.1
# List directory contents in tree format

Package: tree
Version: 2.2.1
Architecture: x86_64
Section: utilities
Description: List directory contents in tree format
Source: https://github.com/Old-Man-Programmer/tree/archive/refs/tags/2.2.1.tar.gz
Source-SHA256:    5caddcbca805131ff590b126d3218019882e4ca10bc9eb490bba51c05b9b3b75

Build-Depends:    
Depends:          auto
Provides:         auto

[build]
make PREFIX=/opt/hud CFLAGS="-O2 -Wall"

[install]
mkdir -p $DESTDIR/opt/hud/bin
mkdir -p $DESTDIR/opt/hud/share/man/man1
install -m 755 tree $DESTDIR/opt/hud/bin/tree
install -m 644 doc/tree.1 $DESTDIR/opt/hud/share/man/man1/tree.1 2>/dev/null || \
install -m 644 man/tree.1 $DESTDIR/opt/hud/share/man/man1/tree.1 2>/dev/null || true

[postinst]
if [ -x /opt/hud/bin/tree ]; then
    echo "✓ tree 2.2.1 installed successfully"
    /opt/hud/bin/tree --version 2>/dev/null || echo "  Location: /opt/hud/bin/tree"
else
    echo "⚠ Warning: /opt/hud/bin/tree not found"
fi

