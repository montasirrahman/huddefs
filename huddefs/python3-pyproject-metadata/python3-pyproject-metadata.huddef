# HUD Package Definition - pyproject-metadata 0.9.1
# Based on BLFS 12.4
Package: python3-pyproject-metadata
Version: 0.9.1
Architecture: x86_64
Section: python
Description: pyproject-metadata-0.9.1 - data class for PEP 621 metadata
Source: https://files.pythonhosted.org/packages/source/p/pyproject-metadata/pyproject_metadata-0.9.1.tar.gz
Source-SHA256:    b8b2253dd1b7062b78cf949a115f02ba7fa4114aabe63fa10528e9e1a954a816

Build-Depends:    python3, python3-flit-core
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pyproject-metadata --break-system-packages

[postinst]
echo "python3-pyproject-metadata 0.9.1 installed"
