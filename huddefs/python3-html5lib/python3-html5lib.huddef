# HUD Package Definition - html5lib 1.1
# Based on BLFS 12.4
Package: python3-html5lib
Version: 1.1
Architecture: x86_64
Section: python
Description: html5lib-1.1 - pure-python library for parsing HTML
Source: https://files.pythonhosted.org/packages/source/h/html5lib/html5lib-1.1.tar.gz
Source-SHA256:    b2e5b40261e20f354d198eae92afc10d750afb487ed5e50f9c4eaf07c184146f

Build-Depends:    python3, python3-six, python3-webencodings, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist html5lib --break-system-packages

[postinst]
echo "python3-html5lib 1.1 installed"
