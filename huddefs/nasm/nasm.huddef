# HUD Package Definition - NASM 2.16.03
# Netwide Assembler

Package: nasm
Version: 2.16.03
Architecture: x86_64
Section: development
Description: Netwide Assembler - x86 assembler
Source: https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz
Source-SHA256:    1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
echo "✓ NASM 2.16.03 installed to /opt/hud"
