# HUD Package Definition - NumPy 2.3.2
# Based on BLFS 12.4
Package: python3-numpy
Version: 2.3.2
Architecture: x86_64
Section: python
Description: NumPy-2.3.2 - fundamental package for scientific computing with Python
Source: https://files.pythonhosted.org/packages/source/n/numpy/numpy-2.3.2.tar.gz
Source-SHA256:    e0486a11ec30cdecb53f184d496d1c6a20786c81e55e41640270130056f8ee48

Build-Depends:    python3, python3-cython, python3-meson-python, python3-pyproject-metadata
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir -C setup-args=-Dallow-noblas=true $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist numpy --break-system-packages

[postinst]
echo "python3-numpy 2.3.2 installed"
