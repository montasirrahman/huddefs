# HUD Package Definition - attrs 25.3.0
# Based on BLFS 12.4
Package: python3-attrs
Version: 25.3.0
Architecture: x86_64
Section: python
Depends: python3,python3-hatch-fancy-pypi-readme,python3-hatch-vcs
Description: Attrs-25.3.0 - writing attributes without extra boilerplate
Source: https://files.pythonhosted.org/packages/source/a/attrs/attrs-25.3.0.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user attrs
[postinst]
echo "python3-attrs 25.3.0 installed"
[prerm]
pip3 uninstall -y attrs 2>/dev/null || true
[postrm]
# Cleanup if needed
