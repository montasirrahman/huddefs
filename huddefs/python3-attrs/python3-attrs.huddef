# HUD Package Definition - attrs 25.3.0
# Based on BLFS 12.4
Package: python3-attrs
Version: 25.3.0
Architecture: x86_64
Section: python
Description: Attrs-25.3.0 - writing attributes without extra boilerplate
Source: https://files.pythonhosted.org/packages/source/a/attrs/attrs-25.3.0.tar.gz
Source-SHA256:    75d7cefc7fb576747b2c81b4442d4d4a1ce0900973527c011d1030fd3bf4af1b

Build-Depends:    python3, python3-hatch-fancy-pypi-readme, python3-hatch-vcs, python3-hatchling
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist attrs --break-system-packages

[postinst]
echo "python3-attrs 25.3.0 installed"
