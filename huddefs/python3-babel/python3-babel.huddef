# HUD Package Definition - babel 2.17.0
# Based on BLFS 12.4
Package: python3-babel
Version: 2.17.0
Architecture: x86_64
Section: python
Description: Babel-2.17.0 - utilities for internationalizing Python applications
Source: https://files.pythonhosted.org/packages/source/B/Babel/babel-2.17.0.tar.gz
Source-SHA256:    0c54cffb19f690cdcc52a3b50bcbf71e07a808d1c80d549f2459b9d2cf0afb9d

Build-Depends:    python3, python3-pytz, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist Babel --break-system-packages

[postinst]
echo "python3-babel 2.17.0 installed"
