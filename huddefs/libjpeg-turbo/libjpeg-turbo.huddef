# HUD Package Definition - libjpeg-turbo 3.1.1
# JPEG image codec with SIMD acceleration
Package: libjpeg-turbo
Version: 3.1.1
Architecture: x86_64
Section: graphics
Description: JPEG image codec with SIMD acceleration
Source: https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/3.1.1/libjpeg-turbo-3.1.1.tar.gz
Source-SHA256:    aadc97ea91f6ef078b0ae3a62bba69e008d9a7db19b34e4ac973b19b71b4217c

Build-Depends:    cmake, nasm
Depends:          auto
Provides:         auto

[configure]
mkdir -p build
cd build
cmake -DCMAKE_INSTALL_PREFIX=/opt/hud -DCMAKE_BUILD_TYPE=Release -DENABLE_STATIC=FALSE -DCMAKE_INSTALL_DEFAULT_LIBDIR=lib ..
[build]
cd build
make
[install]
cd build
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ libjpeg-turbo 3.1.1 installed to /opt/hud"
/sbin/ldconfig
