# HUD Package Definition - xtrans 1.6.0
# X Network Transport layer shared code
Package: xtrans
Version: 1.6.0
Architecture: x86_64
Section: xorg
Depends: util-macros
Description: X Network Transport layer shared code
Source: https://www.x.org/pub/individual/lib/xtrans-1.6.0.tar.xz
[configure]
./configure --prefix=/opt/hud --sysconfdir=/etc --localstatedir=/var --disable-static
[build]
make
[install]
make DESTDIR=$DESTDIR install
[postinst]
echo "✓ xtrans 1.6.0 installed to /opt/hud"
