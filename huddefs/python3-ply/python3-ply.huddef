# HUD Package Definition - ply 3.11
# Based on BLFS 12.4
Package: python3-ply
Version: 3.11
Architecture: x86_64
Section: python
Description: ply-3.11 - Python implementation of lex and yacc parsing tools
Source: https://files.pythonhosted.org/packages/source/p/ply/ply-3.11.tar.gz
Source-SHA256:    00c7c1aaa88358b9c765b6d3000c6eec0ba42abca5351b095321aef446081da3

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist ply --break-system-packages

[postinst]
echo "python3-ply 3.11 installed"
