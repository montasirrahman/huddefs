# HUD Package Definition - ply 3.11
# Based on BLFS 12.4
Package: python3-ply
Version: 3.11
Architecture: x86_64
Section: python
Depends: python3
Description: ply-3.11 - Python implementation of lex and yacc parsing tools
Source: https://files.pythonhosted.org/packages/source/p/ply/ply-3.11.tar.gz
[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD
[install]
pip3 install --no-index --find-links dist --no-user ply
[postinst]
echo "python3-ply 3.11 installed"
[prerm]
pip3 uninstall -y ply 2>/dev/null || true
[postrm]
# Cleanup if needed
