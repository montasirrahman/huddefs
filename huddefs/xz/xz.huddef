# HUD Package Definition - XZ Utils 5.8.0
# LZMA compression library and tools

Package: xz
Version: 5.8.0
Architecture: x86_64
Section: libraries
Description: XZ Utils - LZMA compression library and tools
Source: https://github.com/tukaani-project/xz/releases/download/v5.8.0/xz-5.8.0.tar.xz
Source-SHA256:    05ecad9e71919f4fca9f19fbbc979ea28e230188ed123dc6f06b98031ea14542

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
./configure --prefix=/opt/hud --disable-static

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ XZ Utils 5.8.0 installed to /opt/hud"
