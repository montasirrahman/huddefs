# HUD Package Definition - cpio 2.15
# Archive Tool
# Tools for archiving files

Package: cpio
Version: 2.15
Architecture: x86_64
Section: utilities
Description: Tools for archiving files in cpio format
Source: https://ftp.gnu.org/gnu/cpio/cpio-2.15.tar.bz2
Source-SHA256:    937610b97c329a1ec9268553fb780037bcfff0dcffe9725ebc4fd9c1aa9075db

Build-Depends:    
Depends:          auto
Provides:         auto

[configure]
# Fix for GCC-15
sed -e "/^extern int (\*xstat)/s/()/(const char * restrict,  struct stat * restrict)/" \
    -i src/extern.h
sed -e "/^int (\*xstat)/s/()/(const char * restrict,  struct stat * restrict)/" \
    -i src/global.c

./configure --prefix=/opt/hud \
            --enable-mt       \
            --with-rmt=/usr/libexec/rmt

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
echo "✓ cpio 2.15 installed to /opt/hud"
