# HUD Package Definition - libtirpc 1.3.7 (NEWER VERSION)
# Transport Independent RPC library (replaces older glibc RPC)
# Required by: glusterfs, nfs-utils
# Reference: https://sourceforge.net/projects/libtirpc/
#
# Using version 1.3.7 which has better GCC compatibility

Package: libtirpc
Version: 1.3.7
Architecture: x86_64
Section: libraries
Depends: 
Description: Transport Independent RPC library
Source: https://downloads.sourceforge.net/libtirpc/libtirpc-1.3.7.tar.bz2

[configure]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export PKG_CONFIG_PATH="/opt/hud/lib/pkgconfig:/opt/hud/lib64/pkgconfig:${PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"
export CFLAGS="-I/opt/hud/include -O2"
export LDFLAGS="-L/opt/hud/lib -L/opt/hud/lib64"

./configure --prefix=/opt/hud \
            --sysconfdir=/etc \
            --libdir=/opt/hud/lib64 \
            --disable-static \
            --disable-gssapi

[build]
export PATH="/opt/hud/bin:/opt/hud/sbin:${PATH}"
export LD_LIBRARY_PATH="/opt/hud/lib:/opt/hud/lib64:${LD_LIBRARY_PATH}"

make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

# Create compatibility symlinks
mkdir -p $DESTDIR/usr/lib64
mkdir -p $DESTDIR/usr/include
ln -sf /opt/hud/lib64/libtirpc.so.3 $DESTDIR/usr/lib64/libtirpc.so.3 2>/dev/null || true
ln -sf /opt/hud/include/tirpc $DESTDIR/usr/include/tirpc 2>/dev/null || true

[postinst]
# Add library paths
echo "/opt/hud/lib64" > /etc/ld.so.conf.d/libtirpc.conf
ldconfig

# Create system-wide symlinks for compatibility
ln -sf /opt/hud/lib64/libtirpc.so.3.0.0 /usr/lib64/libtirpc.so.3
ln -sf /usr/lib64/libtirpc.so.3 /usr/lib64/libtirpc.so

# Create header symlinks
ln -sf /opt/hud/include/tirpc /usr/include/tirpc

ldconfig

echo ""
echo "============================================"
echo "libtirpc 1.3.7 installed successfully"
echo "============================================"
echo ""
echo "Library: /opt/hud/lib64/libtirpc.so"
echo "Headers: /opt/hud/include/tirpc/"
echo ""
echo "This replaces deprecated glibc RPC functions"
echo "with a modern, maintained implementation."
echo ""
