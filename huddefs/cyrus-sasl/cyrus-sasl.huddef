# HUD Package Definition - cyrus-sasl 2.1.28
# Auto-generated for oVirt infrastructure

Package: cyrus-sasl
Version: 2.1.28
Architecture: x86_64
Section: security
Description: Cyrus SASL-2.1.28
Source: https://github.com/cyrusimap/cyrus-sasl/releases/download/cyrus-sasl-2.1.28/cyrus-sasl-2.1.28.tar.gz
Source-SHA256:    7ccfc6abd01ed67c1a0924b353e526f1b766b21f42d4562ee635a8ebfc5bb38c
Service: saslauthd

Build-Depends:    linux-pam, postgresql, lmdb, sqlite
Depends:          auto
Provides:         auto

[configure]
# -std=gnu17 because md5.c uses K&R function definitions:
#     md5.c:139: error: too many arguments to function 'MD5_memcpy'; expected 0, have 3
# GCC 15 defaults to C23, where an empty parameter list means "no parameters"
# rather than "unspecified", so every call to those functions is an error. This
# is the conventional fix across distributions and it is what CLAUDE.md's
# toolchain-strictness precedent prescribes — the package then ships exactly
# what it shipped before, rather than less.
export CFLAGS="-std=gnu17 ${CFLAGS:-}"

./configure --prefix=/opt/hud --sysconfdir=/opt/hud/etc --enable-auth-sasldb --with-dbpath=/opt/hud/etc/sasldb2

[build]
make -j$(nproc)

[install]
# DESTDIR is exported by the builder, so `make install` stages correctly.
make install &&

# Documentation, into the prefix and staged. v1 wrote it to /usr/share/doc on
# the build host with no $DESTDIR, so it never shipped — and the last line was
# truncated mid-command:
#     install -v -m644
# with no arguments at all, which under `set -euo pipefail` fails the build. The
# definition as written could not have produced the package that is published.
install -v -dm755 $DESTDIR/opt/hud/share/doc/cyrus-sasl-2.1.28/html &&
install -v -m644 saslauthd/LDAP_SASLAUTHD $DESTDIR/opt/hud/share/doc/cyrus-sasl-2.1.28/ &&
install -v -m644 doc/legacy/*.html $DESTDIR/opt/hud/share/doc/cyrus-sasl-2.1.28/html/ 2>/dev/null || \
install -v -m644 doc/html/*.html $DESTDIR/opt/hud/share/doc/cyrus-sasl-2.1.28/html/

[postinst]
ldconfig 2>/dev/null || true
echo "cyrus-sasl 2.1.28 installed to /opt/hud"

[prerm]
# Stop service if running
systemctl stop hud-saslauthd 2>/dev/null || true
systemctl disable hud-saslauthd 2>/dev/null || true

[postrm]
ldconfig 2>/dev/null || true
