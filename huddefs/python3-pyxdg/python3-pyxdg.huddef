# HUD Package Definition - PyXDG 0.28
# Based on BLFS 12.4
Package: python3-pyxdg
Version: 0.28
Architecture: x86_64
Section: python
Description: PyXDG-0.28 - Python library to access freedesktop.org standards
Source: https://files.pythonhosted.org/packages/b0/25/7998cd2dec731acbd438fbf91bc619603fc5188de0a9a17699a781840452/pyxdg-0.28.tar.gz
Source-SHA256:    3267bb3074e934df202af2ee0868575484108581e6f3cb006af1da35395e88b4

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist pyxdg --break-system-packages

[postinst]
echo "python3-pyxdg 0.28 installed"
