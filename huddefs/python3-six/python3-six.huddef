# HUD Package Definition - six 1.17.0
# Based on BLFS 12.4
Package: python3-six
Version: 1.17.0
Architecture: x86_64
Section: python
Description: six-1.17.0 - Python 2 to 3 compatibility library
Source: https://files.pythonhosted.org/packages/source/s/six/six-1.17.0.tar.gz
Source-SHA256:    ff70335d468e7eb6ec65b95b99d3a2836546063f63acc5171de367e834932a81

Build-Depends:    python3, python-setuptools
Depends:          auto
Provides:         auto

[build]
pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir $PWD

[install]
pip3 install --no-deps --prefix=/opt/hud --root=$DESTDIR --no-index --find-links dist six --break-system-packages

[postinst]
echo "python3-six 1.17.0 installed"
