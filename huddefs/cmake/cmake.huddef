# HUD Package Definition - CMake 4.1.0
# Modern build system generator - Based on LFS 12.4
# Note: Can be built with minimal deps using bundled libraries

Package: cmake
Version: 4.1.0
Architecture: x86_64
Section: development
Description: CMake - Cross-platform build system generator
Source: https://cmake.org/files/v4.1/cmake-4.1.0.tar.gz
Source-SHA256:    81ee8170028865581a8e10eaf055afb620fa4baa0beb6387241241a975033508



Build-Depends:    libarchive, nghttp2
Depends:          auto
Provides:         auto

[configure]
# Fix lib64 issue
sed -i '/"lib64"/s/64//' Modules/GNUInstallDirs.cmake

# Bootstrap cmake - use system libs where available, bundle the rest
# ccmake is DISABLED. It fails under GCC 15: ncurses defines NCURSES_BOOL as a
# macro expanding to unsigned char, cmake's cm::enum_set uses size_type which is
# also unsigned char, and once curses.h is included the two constructor
# signatures collide. ccmake is an interactive ncurses front-end for editing a
# CMake cache by hand — it is not a library, provides no soname, and nothing in
# the repository depends on it. cmake, ctest and cpack all build normally.
# Recorded in docs/reduced-packages.md.
# --no-system-curl breaks the one genuine bootstrap cycle in the distribution:
#
#     cmake -> curl -> brotli -> cmake
#
# curl declares brotli, brotli builds with cmake, and cmake linked the system
# curl. 25 of the 249 packages sit behind that loop and none of them can be
# built from source without cutting it somewhere.
#
# Cutting it here is the cheapest cut. cmake's bundled curl is reachable only
# through cmake's own file(DOWNLOAD) and ctest_submit, neither of which any
# build here uses — the network is disabled during builds. Cutting it at brotli
# instead is not possible: brotli 1.1.0 has no build system but cmake.
#
# The cost is that cmake's curl does not get security updates with the system
# one. The proper answer is a second pass — rebuild cmake with system curl once
# curl exists — and G1 should do that. Until it does, this is the honest
# trade and it is written down rather than implied.
# Everything after `--` is passed to CMAKE, not to bootstrap. The definition had
# --no-system-jsoncpp, --no-system-cppdap, --no-system-librhash and --parallel
# on the far side of it, so the bootstrap cmake was invoked with them and
# stopped:
#     CMake Error: Unknown argument --parallel=4
# They are bootstrap options and belong before the separator.
# -DBUILD_CursesDialog=OFF is a cmake variable and correctly stays after it.
./bootstrap --prefix=/opt/hud \
            --mandir=/opt/hud/share/man \
            --no-system-curl \
            --no-system-jsoncpp \
            --no-system-cppdap \
            --no-system-librhash \
            --parallel=$(nproc) \
            -- -DBUILD_CursesDialog=OFF

[build]
make -j$(nproc)

[install]
make DESTDIR=$DESTDIR install

[postinst]
ldconfig 2>/dev/null || true
echo "✓ CMake 4.1.0 installed to /opt/hud"
