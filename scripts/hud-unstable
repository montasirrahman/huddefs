#!/bin/bash
# Publish to the STAGING repository at /var/www/hud-unstable — never the live one.
#
# hud-repo-manager takes its repository from $HUD_REPO_DIR and defaults to
# /var/www/hud-repo. One forgotten export therefore writes to the live repo,
# whose 251 packages are not reliably rebuildable. This wrapper makes the
# staging directory the only reachable target: it sets the variable itself and
# refuses to run if anything has redirected it at the live tree.
#
# It intentionally does NOT deploy hud-repo-manager to /usr/local/bin; it runs
# the D8-fixed copy from /var/hud-build/bin, leaving the system's v1.1.0
# untouched.
set -euo pipefail

UNSTABLE=/var/www/hud-unstable
MANAGER=/var/hud-build/bin/hud-repo-manager-unstable

[ -x "$MANAGER" ] || { echo "hud-unstable: manager missing at $MANAGER" >&2; exit 2; }
[ -d "$UNSTABLE" ] || { echo "hud-unstable: $UNSTABLE does not exist" >&2; exit 2; }

# Resolve symlinks before comparing: a symlinked hud-unstable pointing at the
# live tree would pass a string comparison and fail this one.
real=$(readlink -f "$UNSTABLE")
case "$real" in
    /var/www/hud-repo|/var/www/hud-repo/*)
        echo "hud-unstable: $UNSTABLE resolves to the LIVE repo ($real). Refusing." >&2
        exit 3 ;;
esac

export HUD_REPO_DIR="$real"

# Serialise every write to the repository.
#
# hud-repo-manager has no locking of its own. `add` copies into the pool and
# INSERTs into packages.db, and `update-index` rewrites packages.list from that
# database — so two concurrent publishes can interleave a copy with an index
# regeneration and produce an index that does not describe the pool. Nothing
# would report it; the next machine to run `hud update` would simply get a
# wrong answer.
#
# flock on a dedicated file rather than on the database: sqlite does its own
# locking for the INSERT but nothing covers the pool copy and the index rewrite
# as one unit. 300s is generous — a publish is a copy and a query — and timing
# out is better than stacking up.
LOCK="/var/lock/hud-unstable.lock"
if [ -z "${HUD_UNSTABLE_LOCKED:-}" ]; then
    export HUD_UNSTABLE_LOCKED=1
    exec flock -w 300 "$LOCK" "$0" "$@"
fi

# Archive the definition the package was actually built from.
#
# hud-repo-manager copies "<name>-<version>.huddef" into the pool only if it
# finds one sitting beside the .hud being added. The driver ships the .hud
# alone, so nothing was archived and the pool kept whatever stale definition
# was there from the original seeding — for python3-attrs, the v1 file, while
# the shipped bits were built from a converted v2. CLAUDE.md calls the archived
# huddef the tiebreaker for which definition is real, so a stale one is worse
# than none.
#
# hud-build stores the definition it used inside the package at
# opt/hud/share/hud/info/<pkg>/<pkg>.huddef. Extracting that and laying it
# beside the .hud makes the pool copy evidence again: it is the file that
# produced these bits, not a guess about them.
#
# Name and version come from the extracted definition rather than from the
# filename — splitting "python3-attrs-25.3.0-x86_64.hud" on dashes cannot tell
# a version apart from a name that contains digits.
stage_definition() {
    local art="$1" tmp def name version
    [ -f "$art" ] || return 0

    def=$(tar tf "$art" 2>/dev/null \
          | grep -m1 -E '^\./opt/hud/share/hud/info/[^/]+/[^/]+\.huddef$') || return 0
    [ -n "$def" ] || return 0

    tmp=$(mktemp) || return 0
    if ! tar xOf "$art" "$def" > "$tmp" 2>/dev/null; then rm -f "$tmp"; return 0; fi

    name=$(sed -n 's/^Package:[[:space:]]*//p'  "$tmp" | head -1)
    version=$(sed -n 's/^Version:[[:space:]]*//p' "$tmp" | head -1)
    if [ -z "$name" ] || [ -z "$version" ]; then rm -f "$tmp"; return 0; fi

    mv "$tmp" "$(dirname "$art")/${name}-${version}.huddef"
    chmod 644 "$(dirname "$art")/${name}-${version}.huddef"
}

# `add` on a name+version that already exists prompts "Replace existing version?
# [y/N]" and reads from stdin. In a driver there is no tty, the read fails, the
# answer is empty, and the manager prints "Skipped" and exits 0 — so E5 would
# republish 35 fixed packages and change nothing, successfully.
#
# Every E5/E6 fix keeps its upstream version by definition (the defect was a
# missing --root, not a version), so replacing is the normal case here, not an
# exceptional one. `--replace` answers the prompt instead of leaving it to a
# stdin that is not there. It is opt-in so an accidental add still stops.
if [ "${1:-}" = "add" ]; then
    if [ "${2:-}" = "--replace" ]; then
        shift 2
        stage_definition "${!#}"
        printf 'y\n' | "$MANAGER" add "$@"
        exit $?
    fi
    stage_definition "${!#}"
fi

exec "$MANAGER" "$@"
