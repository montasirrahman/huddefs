#!/bin/bash
# =============================================================================
# hud-build — build a .hud package from a .huddef, in an isolated root
#
#   hud-build huddefs/qemu/qemu.huddef
#
# Enforces the rules in huddef-v2-spec.md:
#   - Source-SHA256 is verified before anything is unpacked
#   - patches come from patches/ in the repo, and a failure is fatal
#   - the build has no network access
#   - build sections run under set -euo pipefail, so || true cannot hide failures
#   - DESTDIR is checked to be non-empty after [install]
#   - Provides/Requires are derived from the built tree, not hand-written
#
# Isolation uses systemd-nspawn. BlackFlag has systemd but no docker/podman.
# =============================================================================
set -euo pipefail

BUILD_ROOT="${HUD_BUILD_ROOT:-/var/hud-build}"

# Single source of truth for which rootfs to use. Both hud-build and hud-test
# read this file; the path used to be duplicated in each script and drifted.
HUD_BUILD_CONF="${HUD_BUILD_CONF:-/etc/hud-build.conf}"
# shellcheck source=/dev/null
[ -r "$HUD_BUILD_CONF" ] && . "$HUD_BUILD_CONF"

ROOTS_DIR="${HUD_ROOTS_DIR:-$BUILD_ROOT/roots}"
CACHE_DIR="$BUILD_ROOT/cache"
OUTPUT_DIR="$BUILD_ROOT/output"
LOG_DIR="$BUILD_ROOT/logs"
# Resolution order: an explicit HUD_BASE_ROOTFS for this run, then the shared
# default from hud-build.conf, then a hard fallback. The rationale for minimal
# being the default lives in hud-build.conf, next to the value itself.
BASE_ROOTFS="${HUD_BASE_ROOTFS:-${HUD_ROOTFS_DEFAULT:-$BUILD_ROOT/base-rootfs-minimal.tar.zst}}"
PREFIX="/opt/hud"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'; NC=$'\033[0m'
info()  { echo "${BLUE}[INFO]${NC} $*"; }
ok()    { echo "${GREEN}[✓]${NC} $*"; }
warn()  { echo "${YELLOW}[!]${NC} $*"; }
die()   { echo "${RED}[✗]${NC} $*" >&2; exit 1; }

# -----------------------------------------------------------------------------
# huddef parsing
# -----------------------------------------------------------------------------

# header_field <file> <Name>   -> value, or empty
header_field() {
    sed -n '1,/^\[/p' "$1" \
        | grep -m1 -i "^$2:" \
        | cut -d: -f2- \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' || true
}

# section <file> <name>        -> body of [name], or empty
section() {
    awk -v want="[$2]" '
        $0 == want { inside = 1; next }
        /^\[[a-z]+\]$/ { inside = 0 }
        inside { print }
    ' "$1"
}

# -----------------------------------------------------------------------------
# main
# -----------------------------------------------------------------------------
HUDDEF="${1:-}"
[ -n "$HUDDEF" ] || die "usage: hud-build <path/to/package.huddef>"
[ -f "$HUDDEF" ] || die "not found: $HUDDEF"
HUDDEF=$(realpath "$HUDDEF")
DEFDIR=$(dirname "$HUDDEF")

NAME=$(header_field "$HUDDEF" Package)
VERSION=$(header_field "$HUDDEF" Version)
ARCH=$(header_field "$HUDDEF" Architecture); ARCH="${ARCH:-x86_64}"
SECTION=$(header_field "$HUDDEF" Section);   SECTION="${SECTION:-misc}"
DESC=$(header_field "$HUDDEF" Description)
SERVICE=$(header_field "$HUDDEF" Service)
SOURCE=$(header_field "$HUDDEF" Source)
SOURCE_SHA=$(header_field "$HUDDEF" Source-SHA256)
BUILD_DEPS=$(header_field "$HUDDEF" Build-Depends)
DEPENDS=$(header_field "$HUDDEF" Depends); DEPENDS="${DEPENDS:-auto}"
PATCHES=$(header_field "$HUDDEF" Patches)

[ -n "$NAME" ]    || die "Package: is missing"
[ -n "$VERSION" ] || die "Version: is missing"

mkdir -p "$CACHE_DIR" "$OUTPUT_DIR" "$LOG_DIR" "$BUILD_ROOT/work"
# Timestamped, never overwritten. A retry used to clobber the log of the failure
# it was retrying, which is precisely the log you need. The stable
# <name>-<version>.log symlink always points at the newest run.
LOG="$LOG_DIR/${NAME}-${VERSION}-$(date -u +%Y%m%dT%H%M%SZ).log"
ln -sfn "$(basename "$LOG")" "$LOG_DIR/${NAME}-${VERSION}.log"
exec > >(tee "$LOG") 2>&1

info "Building $NAME $VERSION ($ARCH)"
info "Rootfs: $BASE_ROOTFS"

# --- 1. fetch and verify source ----------------------------------------------
TARBALL=""
if [ -n "$SOURCE" ] && [ "$SOURCE" != "none" ]; then
    [ -n "$SOURCE_SHA" ] || die "Source-SHA256: is required when Source: is a URL"

    TARBALL="$CACHE_DIR/$(basename "$SOURCE")"
    if [ ! -f "$TARBALL" ]; then
        info "Fetching $SOURCE"
        curl -fL --proto '=https' --tlsv1.2 -o "$TARBALL.part" "$SOURCE" \
            || die "download failed (no insecure fallback: fix the URL or the cert)"
        mv "$TARBALL.part" "$TARBALL"
    else
        info "Using cached $(basename "$TARBALL")"
    fi

    actual=$(sha256sum "$TARBALL" | cut -d' ' -f1)
    if [ "$actual" != "$SOURCE_SHA" ]; then
        die "SHA256 mismatch
  expected: $SOURCE_SHA
  actual:   $actual
  file:     $TARBALL"
    fi
    ok "Source hash verified"
fi

# --- 2. clean build root ------------------------------------------------------
[ -f "$BASE_ROOTFS" ] || die "base rootfs missing: $BASE_ROOTFS (see WORKFLOW.md step 2)"

WORK=$(mktemp -d "$BUILD_ROOT/work/${NAME}-XXXXXX")
ROOT="$WORK/root"

# Cleanup must unmount before deleting. If $ROOT is still a mountpoint, `rm -rf`
# would delete straight through the overlay into the pristine lower tree, which
# is the golden rootfs every build depends on. Never remove a mountpoint.
cleanup() {
    if mountpoint -q "$ROOT" 2>/dev/null; then
        umount "$ROOT" 2>/dev/null || umount -l "$ROOT" 2>/dev/null
    fi
    if mountpoint -q "$ROOT" 2>/dev/null; then
        warn "$ROOT is still mounted; leaving $WORK in place rather than deleting through it"
        return
    fi
    rm -rf "$WORK"
}
trap cleanup EXIT INT TERM

mkdir -p "$ROOT"

# Prefer an overlay over the pre-extracted tree. Extracting a 3.3 GB rootfs per
# package was most of what a build cost — on bf-repo it was ~100 s of the ~150 s
# a small package took. An overlay makes it a mount.
#
# Requires CONFIG_OVERLAY_FS, which bf-build's kernel has and bf-repo's does not,
# so the tar path below remains the fallback and is not dead code.
#
# The upper layer is on disk rather than tmpfs: hud-build runs two separate
# nspawn invocations (Build-Depends install, then the network-isolated build) and
# has to retrieve the artifact from /dest afterwards. `--volatile=overlay` uses a
# tmpfs upper and discards it when the container exits, which would lose the
# installed dependencies between the two and then the package itself.
RO_ROOT="$ROOTS_DIR/$(basename "$BASE_ROOTFS" | sed 's/^base-rootfs-//; s/^base-rootfs/full/; s/\.tar\.zst$//')"
if grep -q '\boverlay\b' /proc/filesystems 2>/dev/null && [ -d "$RO_ROOT/usr" ]; then
    mkdir -p "$WORK/upper" "$WORK/ovlwork"
    if mount -t overlay overlay \
         -o "lowerdir=$RO_ROOT,upperdir=$WORK/upper,workdir=$WORK/ovlwork" \
         "$ROOT" 2>/dev/null; then
        ROOT_MODE="overlay over $RO_ROOT"
    else
        warn "overlay mount failed; falling back to extracting the image"
        ROOT_MODE=""
    fi
fi

if [ -z "${ROOT_MODE:-}" ]; then
    ROOT_MODE="extracted from $(basename "$BASE_ROOTFS")"
    info "Unpacking clean build root"
    tar --zstd -xf "$BASE_ROOTFS" -C "$ROOT"
fi
info "Build root: $ROOT_MODE"

mkdir -p "$ROOT/build" "$ROOT/dest"

# --- 3. install Build-Depends into the root (network still allowed) -----------
if [ -n "$BUILD_DEPS" ]; then
    deps=$(echo "$BUILD_DEPS" | tr ',' ' ' | tr -s ' ')
    info "Installing build deps: $deps"
    systemd-nspawn -q -D "$ROOT" \
        /bin/bash -c "hud update >/dev/null && hud install -y $deps" \
        || die "build dependency install failed"

    # `hud install` exits 0 even when it resolved nothing — a missing package
    # prints "Package not found" and still returns success, and a failed
    # `hud update` leaves 0 packages available so EVERY dep resolves to nothing.
    # Its exit code therefore proves nothing. Verify each dep landed.
    missing=""
    for d in $deps; do
        systemd-nspawn -q -D "$ROOT" /bin/bash -c \
            "test -f /opt/hud/share/hud/info/$d/PACKAGE" >/dev/null 2>&1 \
            || missing="$missing $d"
    done
    [ -z "$missing" ] || die "Build-Depends did not install:$missing
hud install reported success anyway. Check that the package names exist in the
repository and that the build root can reach it."
    ok "Build deps installed and verified: $deps"
fi

# --- 4. stage source and patches ---------------------------------------------
if [ -n "$TARBALL" ]; then
    info "Unpacking source"
    tar -xf "$TARBALL" -C "$ROOT/build"
    srcname=$(ls "$ROOT/build")
    [ "$(echo "$srcname" | wc -l)" -eq 1 ] || die "tarball did not unpack to a single directory"
    SRC_IN_ROOT="/build/$srcname"
else
    SRC_IN_ROOT="/build"
fi

if [ -n "$PATCHES" ]; then
    mkdir -p "$ROOT/patches"
    for p in $(echo "$PATCHES" | tr ',' ' '); do
        [ -f "$DEFDIR/patches/$p" ] || die "patch not found in repo: patches/$p"
        cp "$DEFDIR/patches/$p" "$ROOT/patches/"
    done
fi

[ -d "$DEFDIR/files" ] && cp -r "$DEFDIR/files" "$ROOT/files"

# --- 5. generate the in-root build script ------------------------------------
{
    echo '#!/bin/bash'
    echo 'set -euo pipefail'
    echo "export DESTDIR=/dest"
    echo "export SRCDIR=$SRC_IN_ROOT"
    echo "export NPROC=\$(nproc)"
    echo "export PATH=$PREFIX/bin:$PREFIX/sbin:\$PATH"
    echo "export PKG_CONFIG_PATH=$PREFIX/lib/pkgconfig:$PREFIX/lib64/pkgconfig"
    echo "export LD_LIBRARY_PATH=$PREFIX/lib:$PREFIX/lib64"
    echo "export CFLAGS=\"-I$PREFIX/include \${CFLAGS:-}\""
    echo "export LDFLAGS=\"-L$PREFIX/lib -L$PREFIX/lib64 \${LDFLAGS:-}\""
    # Build sections run under `set -u`, deliberately — it is what turns a typo
    # into a failed build instead of a silently wrong one. But v1 definitions
    # were written for a shell without it and commonly append to variables the
    # environment is assumed to already have:
    #
    #     export ACLOCAL_PATH="/opt/hud/share/aclocal:${ACLOCAL_PATH}"
    #
    # Under `set -u` that is fatal when the variable is unset, which is how 13
    # xorg libraries — libX11, libXau, libXdmcp, libXext, libXfixes, libXi,
    # libICE, libSM and the rest — all failed identically with
    # "ACLOCAL_PATH: unbound variable".
    #
    # Defining them here is the fix rather than editing 13 definitions, and it
    # matches what the spec already says: the builder supplies the environment,
    # and definitions should not have to.
    echo "export ACLOCAL_PATH=\"$PREFIX/share/aclocal\""
    echo "export XDG_DATA_DIRS=\"\${XDG_DATA_DIRS:-$PREFIX/share:/usr/local/share:/usr/share}\""
    echo "cd \$SRCDIR"

    # patches: failure is fatal, no || true
    for p in $(echo "$PATCHES" | tr ',' ' '); do
        [ -n "$p" ] && echo "echo '>>> applying $p'; patch -Np1 --no-backup-if-mismatch -i /patches/$p"
    done

    for s in configure build install check; do
        body=$(section "$HUDDEF" "$s")
        if [ -n "$body" ]; then
            echo "echo '>>> [$s]'"
            echo "cd \$SRCDIR"
            echo "$body"
        fi
    done
} > "$ROOT/build.sh"
chmod +x "$ROOT/build.sh"

# --- 6. build, with no network ------------------------------------------------
info "Building (network disabled)"
if ! systemd-nspawn -q -D "$ROOT" --private-network /build.sh; then
    die "build failed — see $LOG"
fi
ok "Build succeeded"

DEST="$ROOT/dest"
if [ -z "$(find "$DEST" -type f 2>/dev/null | head -1)" ]; then
    die "DESTDIR is empty after [install].
This is the bug that produced your ~750-byte python3-* packages: the install
step wrote to the build root instead of \$DESTDIR. Check that [install] passes
--root=\$DESTDIR or DESTDIR=\$DESTDIR."
fi

# --- 7. derive dependencies ---------------------------------------------------
info "Scanning for provides and requires"
SCAN=$(hud-scan-deps "$DEST" --json)
PROVIDES=$(echo "$SCAN" | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)["provides"]))')
REQUIRES=$(echo "$SCAN" | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)["requires"]))')
ok "$(echo "$PROVIDES" | tr ',' '\n' | grep -c . || true) provides, $(echo "$REQUIRES" | tr ',' '\n' | grep -c . || true) requires"

if [ "$DEPENDS" = "auto" ]; then
    RUNTIME_DEPS="$REQUIRES"
else
    RUNTIME_DEPS="$DEPENDS"
    warn "Depends: is hand-written; detected requires recorded separately"
fi

# --- 8. assemble the .hud -----------------------------------------------------
INFO_DIR="$DEST$PREFIX/share/hud/info/$NAME"
mkdir -p "$INFO_DIR"

(cd "$DEST" && find . -type f -o -type l | sed 's|^\./||' | sort) > "$INFO_DIR/FILES"
INSTALLED_SIZE=$(du -sk "$DEST" | cut -f1)

cat > "$INFO_DIR/PACKAGE" <<EOF
Package: $NAME
Version: $VERSION
Architecture: $ARCH
Section: $SECTION
Depends: $RUNTIME_DEPS
Provides: $PROVIDES
Requires: $REQUIRES
Description: $DESC
Installed-Size: $INSTALLED_SIZE
Build-Date: $(date -u +"%Y-%m-%d %H:%M:%S UTC")
HUD-Version: 2.0.0
Service: $SERVICE
EOF

for s in postinst prerm; do
    body=$(section "$HUDDEF" "$s")
    if [ -n "$body" ]; then
        { echo '#!/bin/bash'; echo 'set -euo pipefail'; echo "$body"; } > "$INFO_DIR/$s"
        chmod +x "$INFO_DIR/$s"
    fi
done

cp "$HUDDEF" "$INFO_DIR/$(basename "$HUDDEF")"
echo "$NAME" > "$DEST/.owner"

OUT="$OUTPUT_DIR/${NAME}-${VERSION}-${ARCH}.hud"
(cd "$DEST" && tar czf "$OUT" .)

ok "Built $OUT ($(du -h "$OUT" | cut -f1))"
echo
echo "Provides: $PROVIDES"
echo "Requires: $REQUIRES"
echo
echo "Next:  hud-repo-manager add $OUT      # publishes to unstable"
